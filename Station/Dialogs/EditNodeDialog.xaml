<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.EditNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chỉnh sửa node"
    PrimaryButtonText="Lưu thay đổi"
    CloseButtonText="Hủy"
    PrimaryButtonStyle="{StaticResource DkPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Primary"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="DlgTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DkSearchBoxStyle}">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="DlgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid Margin="0,0,0,16" Width="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                    <TextBlock Text="Cập nhật tên, tuyến và vị trí của node"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DkIconButtonStyle}"
                        Click="HeaderClose_Click"
                        ToolTipService.ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Width="400">
        <StackPanel Spacing="16">

            <!-- Validation banner: full border + tint, marker + text. Warning tone, not critical red. -->
            <Border x:Name="ErrorBanner"
                    Background="{ThemeResource DkYellowBgBrush}"
                    BorderBrush="{ThemeResource DkYellowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#x25B2;" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource DkYellowBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{ThemeResource DkYellowBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel>
                <TextBlock Text="Tên node *" Style="{StaticResource DlgFieldLabelStyle}"/>
                <TextBox x:Name="NodeNameTextBox"
                         PlaceholderText="Ví dụ: N1, Node-01..."
                         Style="{StaticResource DlgTextBoxStyle}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Tuyến *" Style="{StaticResource DlgFieldLabelStyle}"/>
                <ComboBox x:Name="LineComboBox"
                          Style="{StaticResource DkComboBoxStyle}"
                          PlaceholderText="Chọn tuyến">
                    <ComboBoxItem Content="Tuyến A1"/>
                    <ComboBoxItem Content="Tuyến A2"/>
                    <ComboBoxItem Content="Tuyến A3"/>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Vị trí *" Style="{StaticResource DlgFieldLabelStyle}"/>
                <TextBox x:Name="LocationTextBox"
                         PlaceholderText="Ví dụ: R1, Khu vực 1..."
                         Style="{StaticResource DlgTextBoxStyle}"/>
            </StackPanel>

            <!-- Sensor count note -->
            <Border Background="{ThemeResource DkInputBgBrush}"
                    BorderBrush="{ThemeResource DkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <TextBlock x:Name="SensorCountInfoText"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
