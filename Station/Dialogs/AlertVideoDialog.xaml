<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.AlertVideoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="0">

    <ContentDialog.Resources>
        <Style x:Key="DlgSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DkLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="1100" Height="650" Background="{ThemeResource DkSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: severity badge, title, subtitle, close -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border x:Name="SeverityBadge"
                            Background="{ThemeResource DkRedBgBrush}"
                            BorderBrush="{ThemeResource DkRedBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SeverityText"
                                   Text="&#x25B2; KHẨN CẤP"
                                   Style="{StaticResource DkTagTextStyle}"
                                   Foreground="{ThemeResource DkRedBrush}"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="AlertTitleText"
                                   Text="Cảnh báo Camera"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="CameraIdText" Text="CAM-03"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource DkTextSecondaryBrush}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="AlertTimeText" Text="-"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"
                                       Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource DkIconButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Đóng"
                        AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </Border>

        <!-- BODY: video (left) + alert detail (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Video area -->
            <Grid Grid.Column="0" Background="{ThemeResource DkDeepBrush}">
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16"
                        Background="{ThemeResource DkBgBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="CAM" Style="{StaticResource DkTagTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VideoCameraName" Text="Camera #03"
                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Detection zone: full 1px outline, label is a tag -->
                <Border x:Name="AlertZoneOverlay"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="260" Height="180"
                        BorderBrush="{ThemeResource DkRedBrush}" BorderThickness="2"
                        CornerRadius="4" Background="Transparent">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-14,0,0"
                            Background="{ThemeResource DkRedBgBrush}"
                            BorderBrush="{ThemeResource DkRedBrush}"
                            BorderThickness="1"
                            CornerRadius="4" Padding="8,3">
                        <TextBlock Text="VÙNG PHÁT HIỆN" Style="{StaticResource DkTagTextStyle}"
                                   Foreground="{ThemeResource DkRedBrush}"/>
                    </Border>
                </Border>

                <!-- Bottom bar -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="{ThemeResource DkBgBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Ảnh bằng chứng lấy từ luồng camera của cảnh báo"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="SnapshotButton" Click="SnapshotButton_Click"
                                Style="{StaticResource DkIconButtonStyle}"
                                ToolTipService.ToolTip="Chụp ảnh bằng chứng"
                                AutomationProperties.Name="Chụp ảnh bằng chứng">
                            <FontIcon Glyph="&#xE722;" FontSize="{StaticResource FontSizeSmall}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Alert detail panel (tonal inset) -->
            <Grid Grid.Column="1"
                  Background="{ThemeResource DkInputBgBrush}"
                  BorderBrush="{ThemeResource DkBorderBrush}"
                  BorderThickness="1,0,0,0">
                <ScrollViewer Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">

                        <!-- Severity block: full border + tint, label + marker, never color alone -->
                        <Border x:Name="SeverityDetailBlock"
                                Background="{ThemeResource DkRedBgBrush}"
                                BorderBrush="{ThemeResource DkRedBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="MỨC ĐỘ NGHIÊM TRỌNG" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock x:Name="SeverityDetailText" Text="&#x25B2; KHẨN CẤP"
                                           FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                                           Foreground="{ThemeResource DkRedBrush}"/>
                                <TextBlock x:Name="AlertCategoryText" Text="Xâm nhập"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="NỘI DUNG CẢNH BÁO" Style="{StaticResource DlgSectionLabelStyle}"/>
                            <Border Background="{ThemeResource DkSurfaceBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="AlertTitleDetail"
                                               Text="Phát hiện xâm nhập trái phép"
                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AlertDescriptionText"
                                               Text="Đang tải..."
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="VỊ TRÍ PHÁT HIỆN" Style="{StaticResource DlgSectionLabelStyle}"/>
                            <Border Background="{ThemeResource DkSurfaceBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="AlertLocationText"
                                               Text="-"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CameraDetailText"
                                               Text="-"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="THỜI GIAN" Style="{StaticResource DlgSectionLabelStyle}"/>
                            <Border Background="{ThemeResource DkSurfaceBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Phát hiện lúc"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                                    <TextBlock x:Name="AlertTimeDetailText"
                                               Text="-"
                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock x:Name="AlertDurationText"
                                               Text="-"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkRedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="HƯỚNG DẪN XỬ LÝ" Style="{StaticResource DlgSectionLabelStyle}"/>
                            <Border Background="{ThemeResource DkSurfaceBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="1" Style="{StaticResource DkTagTextStyle}" Foreground="{ThemeResource DkBlueLightBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Xác nhận cảnh báo và kiểm tra luồng video"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="2" Style="{StaticResource DkTagTextStyle}" Foreground="{ThemeResource DkBlueLightBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Liên hệ bảo vệ tại khu vực ngay lập tức"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3" Style="{StaticResource DkTagTextStyle}" Foreground="{ThemeResource DkBlueLightBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Lưu đoạn video và ghi chú tình huống"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- FOOTER: secondary actions, then primary -->
        <Border Grid.Row="2"
                Background="{ThemeResource DkInputBgBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="DismissButton" Content="Bỏ qua cảnh báo"
                        Click="DismissButton_Click"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DkSecondaryButtonStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CloseButton" Content="Đóng"
                            Click="CloseButton_Click"
                            Style="{StaticResource DkSecondaryButtonStyle}"/>
                    <Button x:Name="AcknowledgeButton"
                            Click="AcknowledgeButton_Click"
                            Style="{StaticResource DkPrimaryButtonStyle}"
                            Content="Xác nhận đã xử lý"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
