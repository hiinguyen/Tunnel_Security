<ContentDialog
    x:Class="Station.Dialogs.DeviceDataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Title="Dữ liệu đo"
    CloseButtonText="Đóng"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Close"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="ChartCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DkInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXXLarge}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextPrimaryBrush}"/>
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextMutedBrush}"/>
        </Style>
        <Style x:Key="StatCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource DkLabelStyle}"/>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ChartFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DkSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Height" Value="250"/>
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}"
                           FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource DkTextPrimaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Style="{StaticResource DkIconButtonStyle}"
                        Click="HeaderClose_Click"
                        ToolTipService.ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid MinWidth="800" MinHeight="560" MaxWidth="2000" MaxHeight="840">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel Spacing="16">

                <!-- Device header -->
                <Border Style="{StaticResource ChartCardStyle}" Margin="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource DkSurfaceBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="SEN" Style="{StaticResource DkTagTextStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="DeviceNameText" Text="Sensor01"
                                       FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            <TextBlock x:Name="DeviceIdText" Text="SEN-001"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource DkTextSecondaryBrush}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="LocationText" Text="A2 / R3 / N5"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2" x:Name="TimeRangeComboBox"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  SelectedIndex="0" MinWidth="160" HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="24 giờ qua"/>
                            <ComboBoxItem Content="7 ngày qua"/>
                            <ComboBoxItem Content="30 ngày qua"/>
                            <ComboBoxItem Content="Tùy chỉnh"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <StackPanel>
                    <Border Style="{StaticResource ChartCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource DkSurfaceBrush}"
                                            BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="TEMP" Style="{StaticResource DkTagTextStyle}"
                                                   Foreground="{ThemeResource SensorAccentTemperatureBrush}"/>
                                    </Border>
                                    <TextBlock Text="Nhiệt độ"
                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="TemperatureValue" Text="0"
                                               Style="{StaticResource MetricValueStyle}" Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource SensorAccentTemperatureBrush}"/>
                                    <TextBlock Text="°C" Style="{StaticResource MetricLabelStyle}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource ChartFrameStyle}">
                                <lvc:CartesianChart Series="{x:Bind TemperatureSeries, Mode=OneTime}"
                                                    XAxes="{x:Bind TemperatureXAxes, Mode=OneTime}"
                                                    YAxes="{x:Bind TemperatureYAxes, Mode=OneTime}"
                                                    TooltipPosition="Top"/>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MIN" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="TempMin" Text="27.2°C" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TRUNG BÌNH" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="TempAvg" Text="31.5°C" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAX" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="TempMax" Text="36.1°C" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ChartCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource DkSurfaceBrush}"
                                            BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="HUM" Style="{StaticResource DkTagTextStyle}"
                                                   Foreground="{ThemeResource SensorAccentWaterLevelBrush}"/>
                                    </Border>
                                    <TextBlock Text="Độ ẩm"
                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="HumidityValue" Text="0"
                                               Style="{StaticResource MetricValueStyle}" Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource SensorAccentWaterLevelBrush}"/>
                                    <TextBlock Text="%" Style="{StaticResource MetricLabelStyle}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource ChartFrameStyle}">
                                <lvc:CartesianChart Series="{x:Bind HumiditySeries, Mode=OneTime}"
                                                    XAxes="{x:Bind HumidityXAxes, Mode=OneTime}"
                                                    YAxes="{x:Bind HumidityYAxes, Mode=OneTime}"
                                                    TooltipPosition="Top"/>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MIN" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="HumidMin" Text="78%" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TRUNG BÌNH" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="HumidAvg" Text="87%" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAX" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="HumidMax" Text="95%" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ChartCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource DkSurfaceBrush}"
                                            BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="VIB" Style="{StaticResource DkTagTextStyle}"
                                                   Foreground="{ThemeResource SensorAccentLightBrush}"/>
                                    </Border>
                                    <TextBlock Text="Rung động"
                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="VibrationValue" Text="0"
                                               Style="{StaticResource MetricValueStyle}" Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource SensorAccentLightBrush}"/>
                                    <TextBlock Text="mm/s" Style="{StaticResource MetricLabelStyle}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource ChartFrameStyle}">
                                <lvc:CartesianChart Series="{x:Bind VibrationSeries, Mode=OneTime}"
                                                    XAxes="{x:Bind VibrationXAxes, Mode=OneTime}"
                                                    YAxes="{x:Bind VibrationYAxes, Mode=OneTime}"
                                                    TooltipPosition="Top"/>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MIN" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="VibMin" Text="0.8 mm/s" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TRUNG BÌNH" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="VibAvg" Text="1.9 mm/s" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAX" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="VibMax" Text="4.2 mm/s" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ChartCardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource DkSurfaceBrush}"
                                            BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="MOT" Style="{StaticResource DkTagTextStyle}"
                                                   Foreground="{ThemeResource SensorAccentRadarBrush}"/>
                                    </Border>
                                    <TextBlock Text="Chuyển động"
                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="MotionValue" Text="0"
                                               Style="{StaticResource MetricValueStyle}" Typography.NumeralAlignment="Tabular"
                                               Foreground="{ThemeResource SensorAccentRadarBrush}"/>
                                    <TextBlock Text="sự kiện" Style="{StaticResource MetricLabelStyle}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource ChartFrameStyle}">
                                <lvc:CartesianChart Series="{x:Bind MotionSeries, Mode=OneTime}"
                                                    XAxes="{x:Bind MotionXAxes, Mode=OneTime}"
                                                    YAxes="{x:Bind MotionYAxes, Mode=OneTime}"
                                                    TooltipPosition="Top"/>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HÔM NAY" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="MotionToday" Text="12" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TUẦN NÀY" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="MotionWeek" Text="87" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="THÁNG NÀY" Style="{StaticResource StatCaptionStyle}"/>
                                    <TextBlock x:Name="MotionMonth" Text="342" Style="{StaticResource StatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
