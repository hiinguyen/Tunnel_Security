<ContentDialog
    x:Class="Station.Dialogs.DeviceControlDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    CloseButtonText="Đóng"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Close"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="SensorCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DkInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="NodeStatCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource DkLabelStyle}"/>
        <Style x:Key="NodeStatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="560" MinHeight="460" MaxHeight="640" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: node name, status, id, actions, close -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="DeviceNameText"
                               Text="Node"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border x:Name="StatusBadge"
                            Background="{ThemeResource DkGrayBgBrush}"
                            BorderBrush="{ThemeResource DkGrayBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#x25CB; Chưa rõ"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkGrayBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DeviceIdText"
                           Text="-"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource DkTextMutedBrush}"
                           Typography.NumeralAlignment="Tabular"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button x:Name="ViewCameraButton"
                        Click="ViewCameraButton_Click"
                        Style="{StaticResource DkSecondaryButtonStyle}"
                        MinHeight="34" Padding="12,4"
                        ToolTipService.ToolTip="Xem lại video của node"
                        Content="Xem camera"/>
                <Button x:Name="SettingsButton"
                        Click="EditDeviceButton_Click"
                        Style="{StaticResource DkIconButtonStyle}"
                        ToolTipService.ToolTip="Chỉnh sửa thiết bị"
                        AutomationProperties.Name="Chỉnh sửa thiết bị">
                    <FontIcon Glyph="&#xE713;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
                <Button Style="{StaticResource DkIconButtonStyle}"
                        Click="HeaderClose_Click"
                        ToolTipService.ToolTip="Đóng"
                        AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- NODE STATUS STRIP: one continuous inset, no pictograms -->
        <Border Grid.Row="1"
                Background="{ThemeResource DkInputBgBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Padding="16,12">
                    <TextBlock Text="PIN" Style="{StaticResource NodeStatCaptionStyle}"/>
                    <TextBlock x:Name="BatteryText" Text="-" Style="{StaticResource NodeStatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="{ThemeResource DkBorderBrush}"/>

                <StackPanel Grid.Column="2" Padding="16,12">
                    <TextBlock Text="TÍN HIỆU" Style="{StaticResource NodeStatCaptionStyle}"/>
                    <TextBlock x:Name="RSSIText" Text="-" Style="{StaticResource NodeStatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Fill="{ThemeResource DkBorderBrush}"/>

                <StackPanel Grid.Column="4" Padding="16,12">
                    <TextBlock Text="CẬP NHẬT" Style="{StaticResource NodeStatCaptionStyle}"/>
                    <TextBlock x:Name="LastOnlineText" Text="-" Style="{StaticResource NodeStatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <Rectangle Grid.Column="5" Fill="{ThemeResource DkBorderBrush}"/>

                <StackPanel Grid.Column="6" Padding="16,12">
                    <TextBlock Text="CẢM BIẾN" Style="{StaticResource NodeStatCaptionStyle}"/>
                    <TextBlock x:Name="SensorCountText" Text="-" Style="{StaticResource NodeStatValueStyle}" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SENSORS -->
        <Grid Grid.Row="2" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="SensorHeaderText"
                       Text="Cảm biến gắn trong node"
                       FontSize="{StaticResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DkTextSecondaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Empty state: collapsed from code once sensors load -->
                    <Border x:Name="SensorEmptyState"
                            Style="{StaticResource SensorCardBorderStyle}"
                            Padding="24">
                        <TextBlock Text="Chưa có cảm biến nào để hiển thị"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ItemsControl x:Name="SensorsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SensorCardBorderStyle}"
                                        PointerPressed="SensorCard_PointerPressed"
                                        Tag="{Binding}"
                                        PointerEntered="SensorCard_PointerEntered"
                                        PointerExited="SensorCard_PointerExited">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instrument tag -->
                                        <Border Grid.Column="0"
                                                MinWidth="52"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                BorderBrush="{ThemeResource DkBorderBrush}"
                                                BorderThickness="1"
                                                Background="{Binding IconBackground}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}"
                                                       Style="{StaticResource DkTagTextStyle}"
                                                       Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Type}" Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StateText}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{Binding ValueColor}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock FontSize="{StaticResource FontSizeLarge}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding ValueColor}"
                                                       TextAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular">
                                                <Run Text="{Binding Value}"/>
                                                <Run Text="{Binding Unit}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource DkTextMutedBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- CONTROL ACTIONS: verb-labelled -->
        <StackPanel Grid.Row="3" Spacing="10">
            <InfoBar x:Name="NotificationBar"
                     IsOpen="False"
                     Severity="Success"
                     IsClosable="True"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PowerOnButton"
                        Click="PowerOnButton_Click"
                        Style="{StaticResource DkSecondaryButtonStyle}"
                        Content="Bật node"/>
                <Button x:Name="PowerOffButton"
                        Click="PowerOffButton_Click"
                        Style="{StaticResource DkSecondaryButtonStyle}"
                        Content="Tắt node"/>
                <Button x:Name="RebootButton"
                        Click="RebootButton_Click"
                        Style="{StaticResource DkSecondaryButtonStyle}"
                        Content="Khởi động lại"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
