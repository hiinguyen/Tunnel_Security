<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.NodeDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Dialogs"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="0">

    <ContentDialog.Resources>
        <Style x:Key="DetailRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>
        <Style x:Key="DetailKeyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DkInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="960" MaxWidth="1000" Height="780">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: node name, status, location, close -->
        <Border Grid.Row="0" Padding="24,16"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="DialogNodeName"
                                   FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="DialogStatusBadge" Padding="9,4" CornerRadius="4"
                                VerticalAlignment="Center" BorderThickness="1">
                            <TextBlock x:Name="DialogStatusText"
                                       FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DialogNodeLocation"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource DkIconButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="Tab1Border" Padding="14,0" BorderBrush="{ThemeResource DkBlueLightBrush}" BorderThickness="0,0,0,2" Tapped="Tab_Tapped" Tag="0">
                    <TextBlock x:Name="Tab1Text" Text="Thông tin chung" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{ThemeResource DkBlueLightBrush}" Padding="0,12"/>
                </Border>
                <Border x:Name="Tab2Border" Padding="14,0" BorderBrush="Transparent" BorderThickness="0,0,0,2" Tapped="Tab_Tapped" Tag="1">
                    <TextBlock x:Name="Tab2Text" Text="Cấu hình &amp; Cài đặt" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextMutedBrush}" Padding="0,12"/>
                </Border>
                <Border x:Name="Tab3Border" Padding="14,0" BorderBrush="Transparent" BorderThickness="0,0,0,2" Tapped="Tab_Tapped" Tag="2">
                    <TextBlock x:Name="Tab3Text" Text="Dữ liệu trực tiếp" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextMutedBrush}" Padding="0,12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24">
            <Grid>

                <!-- TAB 1: GENERAL -->
                <StackPanel x:Name="Tab1Panel" Spacing="16">

                    <!-- Details and location -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN CHI TIẾT" Style="{StaticResource DkLabelStyle}" Margin="0,0,0,4"/>

                                <Border Style="{StaticResource DetailRowStyle}">
                                    <Grid>
                                        <TextBlock Text="Trạng thái" Style="{StaticResource DetailKeyStyle}"/>
                                        <TextBlock x:Name="DetailStatusText" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource DetailRowStyle}">
                                    <Grid>
                                        <TextBlock Text="Tuyến" Style="{StaticResource DetailKeyStyle}"/>
                                        <TextBlock x:Name="DetailLineText" Style="{StaticResource DetailValueStyle}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource DetailRowStyle}">
                                    <Grid>
                                        <TextBlock Text="Số cảm biến" Style="{StaticResource DetailKeyStyle}"/>
                                        <TextBlock x:Name="DetailSensorCountText" Style="{StaticResource DetailValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="VỊ TRÍ" Style="{StaticResource DkLabelStyle}"/>
                                <Border Background="{ThemeResource DkSurfaceBrush}"
                                        BorderBrush="{ThemeResource DkBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" MinHeight="150" Padding="16">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock x:Name="MapLocationText"
                                                   FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Chưa có bản đồ vị trí cho node này"
                                                   FontSize="{StaticResource FontSizeCompact}"
                                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sensor readings -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="THÔNG SỐ CẢM BIẾN TRỰC TIẾP" Style="{StaticResource DkLabelStyle}"/>

                            <ItemsRepeater x:Name="SensorReadingsRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="4" MinItemWidth="100" ItemsStretch="Fill" MinColumnSpacing="12" MinRowSpacing="12"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <StackPanel Spacing="8">
                                                <Border Background="{ThemeResource DkInputBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SensorTypeDisplay}" Style="{StaticResource DkTagTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding CurrentValue}" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                                                               Foreground="{ThemeResource DkTextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Text="{Binding Unit}" FontSize="{StaticResource FontSizeCompact}"
                                                               Foreground="{ThemeResource DkTextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 2: CONFIG (empty state) -->
                <Border x:Name="Tab2Panel" Visibility="Collapsed" Style="{StaticResource PanelCardStyle}" Padding="40" MinHeight="420">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="Cấu hình node chưa khả dụng" FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tính năng này sẽ được cập nhật trong phiên bản tiếp theo của hệ thống."
                                   FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource DkTextMutedBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- TAB 3: LIVE DATA -->
                <Grid x:Name="Tab3Panel" Visibility="Collapsed" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="CAM" Style="{StaticResource DkTagTextStyle}"/>
                                </Border>
                                <TextBlock Text="Camera trực tiếp" FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="{ThemeResource DkDeepBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Height="180">
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,12" Spacing="4">
                                    <TextBlock x:Name="CamTimestampText"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock x:Name="CamIdText"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="Mã định danh (Camera ID)" Style="{StaticResource DetailKeyStyle}"/>
                                    <TextBlock x:Name="CamIdDetail" Style="{StaticResource DetailValueStyle}" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Trạng thái kết nối" Style="{StaticResource DetailKeyStyle}"/>
                                    <TextBlock x:Name="CamStatusDetail" Text="Đang truyền phát"
                                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkGreenBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- FOOTER: destructive action is verb-labelled; Close is the primary exit -->
        <Border Grid.Row="3"
                Background="{ThemeResource DkInputBgBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DkSecondaryButtonStyle}"
                        Click="RestartButton_Click" HorizontalAlignment="Left"
                        Content="Khởi động lại node"/>

                <Button Grid.Column="1" Style="{StaticResource DkPrimaryButtonStyle}"
                        Click="CloseButton_Click" Content="Đóng"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
