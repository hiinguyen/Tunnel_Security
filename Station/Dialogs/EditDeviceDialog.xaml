<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.EditDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chỉnh sửa thiết bị"
    PrimaryButtonText="Lưu thay đổi"
    CloseButtonText="Hủy"
    PrimaryButtonStyle="{StaticResource DkPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Primary"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="DlgTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DkSearchBoxStyle}">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="DlgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                    <TextBlock Text="Thông tin kết nối và định danh thiết bị"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DkIconButtonStyle}"
                        Click="HeaderClose_Click"
                        ToolTipService.ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Width="440">
        <StackPanel Spacing="14">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tên thiết bị *" Style="{StaticResource DlgFieldLabelStyle}"/>
                    <TextBox x:Name="DeviceNameTextBox"
                             PlaceholderText="Nhập tên thiết bị"
                             Style="{StaticResource DlgTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Mã thiết bị (không đổi)" Style="{StaticResource DlgFieldLabelStyle}"/>
                    <TextBox x:Name="DeviceIdTextBox"
                             IsEnabled="False"
                             Style="{StaticResource DlgTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Địa chỉ IP *" Style="{StaticResource DlgFieldLabelStyle}"/>
                    <TextBox x:Name="IpAddressTextBox"
                             PlaceholderText="192.168.1.100"
                             Style="{StaticResource DlgTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Loại thiết bị" Style="{StaticResource DlgFieldLabelStyle}"/>
                    <TextBox x:Name="TypeDisplayTextBox"
                             PlaceholderText="Loại thiết bị"
                             Style="{StaticResource DlgTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <StackPanel>
                <TextBlock Text="Vị trí" Style="{StaticResource DlgFieldLabelStyle}"/>
                <TextBox x:Name="LocationTextBox"
                         PlaceholderText="A1 / R1 / N1"
                         Style="{StaticResource DlgTextBoxStyle}"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hãng sản xuất" Style="{StaticResource DlgFieldLabelStyle}"/>
                    <TextBox x:Name="ManufacturerTextBox"
                             PlaceholderText="Hikvision, Dahua, ..."
                             Style="{StaticResource DlgTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Phiên bản firmware" Style="{StaticResource DlgFieldLabelStyle}"/>
                    <TextBox x:Name="FirmwareVersionTextBox"
                             PlaceholderText="V5.7.3"
                             Style="{StaticResource DlgTextBoxStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
