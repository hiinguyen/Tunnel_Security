<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.SensorDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chi tiết cảm biến"
    PrimaryButtonText="Lưu"
    CloseButtonText="Đóng"
    PrimaryButtonStyle="{StaticResource DkPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Primary"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="DlgTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DkSearchBoxStyle}">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="DlgKeyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DlgPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DkInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                    <TextBlock Text="Cấu hình, giá trị hiện tại và lịch sử đo"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DkIconButtonStyle}"
                        Click="HeaderClose_Click"
                        ToolTipService.ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid MinWidth="700" MinHeight="500">
        <TabView x:Name="SensorTabView"
                 TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 Background="Transparent">

            <TabView.TabItems>
                <!-- Configuration tab -->
                <TabViewItem Header="Cấu hình" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                        <StackPanel Spacing="20">

                            <StackPanel Spacing="10">
                                <TextBlock Text="THÔNG TIN CẢM BIẾN" Style="{StaticResource DkLabelStyle}"/>
                                <Border Style="{StaticResource DlgPanelStyle}">
                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID cảm biến" Style="{StaticResource DlgKeyStyle}"/>
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{x:Bind Sensor.SensorId, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource DlgTextBoxStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên cảm biến" Style="{StaticResource DlgKeyStyle}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{x:Bind Sensor.SensorName, Mode=TwoWay}"
                                                 Style="{StaticResource DlgTextBoxStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Loại cảm biến" Style="{StaticResource DlgKeyStyle}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{x:Bind Sensor.SensorType, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource DlgTextBoxStyle}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Trạng thái" Style="{StaticResource DlgKeyStyle}"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1"
                                                  Style="{StaticResource DkComboBoxStyle}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Hoạt động"/>
                                            <ComboBoxItem Content="Tạm dừng"/>
                                            <ComboBoxItem Content="Bảo trì"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="NGƯỠNG CẢNH BÁO" Style="{StaticResource DkLabelStyle}"/>
                                <Border Style="{StaticResource DlgPanelStyle}">
                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngưỡng thấp" Style="{StaticResource DlgKeyStyle}"/>
                                        <NumberBox Grid.Row="0" Grid.Column="1" Value="0" SpinButtonPlacementMode="Inline"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngưỡng cao" Style="{StaticResource DlgKeyStyle}"/>
                                        <NumberBox Grid.Row="1" Grid.Column="1" Value="100" SpinButtonPlacementMode="Inline"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Chu kỳ đọc (giây)" Style="{StaticResource DlgKeyStyle}"/>
                                        <NumberBox Grid.Row="2" Grid.Column="1" Value="5" Minimum="1" SpinButtonPlacementMode="Inline"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="KÊNH CẢNH BÁO" Style="{StaticResource DkLabelStyle}"/>
                                <Border Style="{StaticResource DlgPanelStyle}">
                                    <StackPanel Spacing="12">
                                        <ToggleSwitch Header="Cảnh báo email" IsOn="True"/>
                                        <ToggleSwitch Header="Cảnh báo SMS" IsOn="False"/>
                                        <ToggleSwitch Header="Cảnh báo âm thanh" IsOn="True"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Data tab -->
                <TabViewItem Header="Dữ liệu" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                        <StackPanel Spacing="20">

                            <StackPanel Spacing="10">
                                <TextBlock Text="GIÁ TRỊ HIỆN TẠI" Style="{StaticResource DkLabelStyle}"/>
                                <Border Style="{StaticResource DlgPanelStyle}" Padding="24">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock FontSize="{StaticResource FontSizeXLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular">
                                            <Run Text="{x:Bind Sensor.CurrentValue, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{x:Bind Sensor.Unit, Mode=OneWay}" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource DkTextMutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Sensor.SensorName, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                                   HorizontalAlignment="Center">
                                            <Run Text="Cập nhật:"/>
                                            <Run Text="{x:Bind Sensor.LastUpdateText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="THỐNG KÊ 24 GIỜ QUA" Style="{StaticResource DkLabelStyle}"/>
                                <Border Style="{StaticResource DlgPanelStyle}" Padding="24">
                                    <TextBlock Text="Chưa có dữ liệu thống kê cho cảm biến này"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="LỊCH SỬ ĐỌC GẦN ĐÂY" Style="{StaticResource DkLabelStyle}"/>
                                <Border Style="{StaticResource DlgPanelStyle}" Padding="24">
                                    <TextBlock Text="Chưa có lịch sử đọc cho cảm biến này"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</ContentDialog>
