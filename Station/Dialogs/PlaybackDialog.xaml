<ContentDialog
    x:Class="Station.Dialogs.PlaybackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Phát lại"
    CloseButtonText="Đóng"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Close"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <local:DoubleToIntConverter x:Key="DoubleToIntConverter"/>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                    <TextBlock Text="Xem lại video đã ghi theo ngày"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DkIconButtonStyle}"
                        Click="HeaderClose_Click"
                        ToolTipService.ToolTip="Đóng" AutomationProperties.Name="Đóng">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <Grid MinWidth="800" MinHeight="520" MaxWidth="900" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="NotificationBar"
                 Grid.Row="0"
                 IsOpen="False"
                 Severity="Success"/>

        <!-- Video area -->
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="1"
                Background="{ThemeResource DkDeepBrush}">
            <Grid>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16"
                        Background="{ThemeResource DkBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="CAM" Style="{StaticResource DkTagTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DeviceNameOverlay"
                                   Text="Playback - D1"
                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16"
                        Background="{ThemeResource DkBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,4">
                    <TextBlock FontSize="{StaticResource FontSizeCompact}" Foreground="{ThemeResource DkTextSecondaryBrush}">
                        <Run Text="IR"/>
                        <Run x:Name="IRStatus" Text="ON" FontWeight="SemiBold"/>
                        <Run Text="  HDR"/>
                        <Run x:Name="HDRStatus" Text="AUTO" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16"
                        Background="{ThemeResource DkBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,4">
                    <TextBlock FontSize="{StaticResource FontSizeCompact}" Foreground="{ThemeResource DkTextSecondaryBrush}"
                               Typography.NumeralAlignment="Tabular">
                        <Run Text="Độ phân giải"/>
                        <Run x:Name="ResolutionText" Text="1280×720" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>

                <!-- Loading indicator (hidden by default) -->
                <Grid x:Name="LoadingPanel" Visibility="Collapsed" Background="{ThemeResource DkScrimBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="32" Height="32" Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                        <TextBlock Text="Đang tải video..."
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="2" Background="{ThemeResource DkInputBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Transport -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource DkIconButtonStyle}"
                                Click="PlayPauseButton_Click"
                                ToolTipService.ToolTip="Phát / Tạm dừng"
                                AutomationProperties.Name="Phát / Tạm dừng">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>
                        <Button x:Name="StopButton"
                                Style="{StaticResource DkIconButtonStyle}"
                                Click="StopButton_Click"
                                ToolTipService.ToolTip="Dừng"
                                AutomationProperties.Name="Dừng">
                            <FontIcon Glyph="&#xE71A;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>
                        <Button Style="{StaticResource DkIconButtonStyle}"
                                Click="RewindButton_Click"
                                ToolTipService.ToolTip="Tua lùi 10 giây"
                                AutomationProperties.Name="Tua lùi 10 giây">
                            <FontIcon Glyph="&#xE892;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>
                        <Button Style="{StaticResource DkIconButtonStyle}"
                                Click="FastForwardButton_Click"
                                ToolTipService.ToolTip="Tua tới 10 giây"
                                AutomationProperties.Name="Tua tới 10 giây">
                            <FontIcon Glyph="&#xE893;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>

                        <TextBlock x:Name="TimeDisplay"
                                   Text="00:00:00 / 01:30:00"
                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <Slider Grid.Column="1"
                            x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="5400"
                            Value="0"
                            Margin="20,0"
                            VerticalAlignment="Center"
                            ValueChanged="ProgressSlider_ValueChanged"/>

                    <!-- Volume, speed, snapshot, fullscreen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource DkIconButtonStyle}"
                                ToolTipService.ToolTip="Âm lượng"
                                AutomationProperties.Name="Âm lượng">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="40" Height="120">
                                        <Slider x:Name="VolumeSlider"
                                                Orientation="Vertical"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="50"
                                                TickFrequency="10"
                                                Height="100"/>
                                        <TextBlock Text="{x:Bind VolumeSlider.Value, Mode=OneWay, Converter={StaticResource DoubleToIntConverter}}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon Glyph="&#xE767;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>

                        <Button Style="{StaticResource DkSecondaryButtonStyle}"
                                MinHeight="34" Padding="10,4"
                                ToolTipService.ToolTip="Tốc độ phát"
                                AutomationProperties.Name="Tốc độ phát">
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="0.5x" Click="SpeedOption_Click" Tag="0.5"/>
                                    <MenuFlyoutItem Text="1x" Click="SpeedOption_Click" Tag="1"/>
                                    <MenuFlyoutItem Text="1.5x" Click="SpeedOption_Click" Tag="1.5"/>
                                    <MenuFlyoutItem Text="2x" Click="SpeedOption_Click" Tag="2"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SpeedText"
                                           Text="1x"
                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource FontSizeXSmall}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DkIconButtonStyle}"
                                Click="SnapshotButton_Click"
                                ToolTipService.ToolTip="Chụp ảnh"
                                AutomationProperties.Name="Chụp ảnh">
                            <FontIcon Glyph="&#xE722;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>

                        <Button Style="{StaticResource DkIconButtonStyle}"
                                Click="FullscreenButton_Click"
                                ToolTipService.ToolTip="Toàn màn hình"
                                AutomationProperties.Name="Toàn màn hình">
                            <FontIcon Glyph="&#xE740;" FontSize="{StaticResource FontSizeBody}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Ngày" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextMutedBrush}" VerticalAlignment="Center"/>
                        <CalendarDatePicker x:Name="PlaybackDatePicker"
                                            PlaceholderText="Chọn ngày"
                                            Date="{x:Bind CurrentDate, Mode=TwoWay}"
                                            DateChanged="PlaybackDatePicker_DateChanged"
                                            Background="{ThemeResource DkInputBgBrush}"
                                            BorderBrush="{ThemeResource DkBorderBrush}"
                                            CornerRadius="8"
                                            MinWidth="160"
                                            VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource DkPrimaryButtonStyle}"
                            Click="DownloadButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Tải đoạn video"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
