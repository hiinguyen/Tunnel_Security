<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Station.Dialogs.AddNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Thêm thiết bị node mới"
    PrimaryButtonText="Thêm node"
    CloseButtonText="Hủy bỏ"
    PrimaryButtonStyle="{StaticResource DkPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DkSecondaryButtonStyle}"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    
    Background="{ThemeResource DkSurfaceBrush}"
    BorderBrush="{ThemeResource DkBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    Padding="24">

    <ContentDialog.Resources>
        <Style x:Key="DlgTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DkSearchBoxStyle}">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="DlgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="{Binding}"
                           FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                <TextBlock Text="Khai báo node và 7 cảm biến đi kèm"
                           FontSize="{StaticResource FontSizeCompact}"
                           Foreground="{ThemeResource DkTextMutedBrush}"/>
            </StackPanel>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Width="680" Padding="0,0,16,0">
        <StackPanel Spacing="20">

            <!-- SECTION 1: NODE INFO -->
            <StackPanel Spacing="10">
                <TextBlock Text="THÔNG TIN CƠ BẢN" Style="{StaticResource DkLabelStyle}"/>

                <Border Background="{ThemeResource DkInputBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid RowSpacing="16" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Tên node *" Style="{StaticResource DlgFieldLabelStyle}"/>
                            <TextBox x:Name="NodeNameTextBox" PlaceholderText="Ví dụ: N1, Node-01..." Style="{StaticResource DlgTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Tuyến *" Style="{StaticResource DlgFieldLabelStyle}"/>
                            <ComboBox x:Name="LineComboBox" PlaceholderText="Chọn tuyến" Style="{StaticResource DkComboBoxStyle}">
                                <ComboBoxItem Content="Tuyến A1"/>
                                <ComboBoxItem Content="Tuyến A2"/>
                                <ComboBoxItem Content="Tuyến A3"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <TextBlock Text="Vị trí *" Style="{StaticResource DlgFieldLabelStyle}"/>
                            <TextBox x:Name="LocationTextBox" PlaceholderText="Ví dụ: R1, Khu vực 1..." Style="{StaticResource DlgTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <TextBlock Text="Mô tả / ghi chú" Style="{StaticResource DlgFieldLabelStyle}"/>
                            <TextBox x:Name="DescriptionTextBox" PlaceholderText="Mô tả vị trí hoặc ghi chú..."
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                     Style="{StaticResource DlgTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION 2: SENSORS -->
            <StackPanel Spacing="10">
                <TextBlock Text="CẢM BIẾN ĐI KÈM (7)" Style="{StaticResource DkLabelStyle}"/>

                <Border Background="{ThemeResource DkInputBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <!-- Column headers -->
                        <Border Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="16,9">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LOẠI" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="CẢM BIẾN" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="TRẠNG THÁI" Style="{StaticResource DkLabelStyle}"/>
                            </Grid>
                        </Border>

                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="RAD" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="1. Radar phát hiện người" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="RadarIdTextBox" PlaceholderText="RAD-001"
                                             AutomationProperties.Name="ID cảm biến RAD"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="RadarStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến RAD"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="CAM" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="2. Camera hồng ngoại" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="CameraIdTextBox" PlaceholderText="CAM-001"
                                             AutomationProperties.Name="ID cảm biến CAM"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="CameraStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến CAM"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="PIR" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="3. Cảm biến hồng ngoại (PIR)" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="PirIdTextBox" PlaceholderText="PIR-001"
                                             AutomationProperties.Name="ID cảm biến PIR"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="PirStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến PIR"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="THM" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="4. Cảm biến nhiệt độ và độ ẩm" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="TempHumidIdTextBox" PlaceholderText="THM-001"
                                             AutomationProperties.Name="ID cảm biến THM"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="TempHumidStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến THM"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="LUX" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="5. Cảm biến ánh sáng" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="LightIdTextBox" PlaceholderText="LUX-001"
                                             AutomationProperties.Name="ID cảm biến LUX"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="LightStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến LUX"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="LVL" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="6. Cảm biến mực nước" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="WaterIdTextBox" PlaceholderText="WTR-001"
                                             AutomationProperties.Name="ID cảm biến LVL"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="WaterStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến LVL"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}" BorderThickness="0" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}" BorderBrush="{ThemeResource DkBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,3" VerticalAlignment="Center">
                                        <TextBlock Text="VIB" Style="{StaticResource DkTagTextStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="7. Cảm biến gia tốc (rung động)" FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="2" x:Name="AccelerometerIdTextBox" PlaceholderText="ACC-001"
                                             AutomationProperties.Name="ID cảm biến VIB"
                                             Style="{StaticResource DlgTextBoxStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="AccelerometerStatusComboBox" SelectedIndex="0"
                                              AutomationProperties.Name="Trạng thái cảm biến VIB"
                                              Style="{StaticResource DkComboBoxStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Hoạt động"/>
                                        <ComboBoxItem Content="Tắt"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource DkTextMutedBrush}"
                           Text="Mỗi node được tự động cấu hình với 7 loại cảm biến cơ bản. Có thể chỉnh sửa ID và trạng thái bật/tắt cho từng cảm biến theo thực tế. ID để trống sẽ được tạo tự động."/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
