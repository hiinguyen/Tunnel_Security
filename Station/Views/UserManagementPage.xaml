<Page
    x:Class="Station.Views.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Station.ViewModels"
    xmlns:views="using:Station.Views"
    Background="{ThemeResource DkBgBrush}">

    <Page.DataContext>
        <vm:UserManagementViewModel />
    </Page.DataContext>

    <Page.Resources>
        <!-- Rows are flat: hover is a subtle overlay, selection is the dark-blue tonal step. -->
        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#0D1D3B" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#122A52" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#122A52" />
        <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
        <Thickness x:Key="ListViewItemBorderThickness">0</Thickness>
        <Thickness x:Key="ListViewItemPadding">0</Thickness>

        <Style x:Key="UmRowItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Quản trị người dùng"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LoadStatus}"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{ThemeResource DkTextMutedBrush}" />
                    </StackPanel>

                    <!-- Tab switcher -->
                    <Border Background="{ThemeResource DkInputBgBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="UsersTabButton"
                                    Style="{StaticResource DkSegmentButtonStyle}"
                                    Content="Người dùng"
                                    Background="{ThemeResource DkBlueBgBrush}"
                                    Foreground="{ThemeResource DkBlueLightBrush}"
                                    Click="UsersTabButton_Click" />
                            <Button x:Name="RolesTabButton"
                                    Style="{StaticResource DkSegmentButtonStyle}"
                                    Content="Phân quyền"
                                    Click="RolesTabButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="ViewAuditLogs_Click"
                        Style="{StaticResource DkSecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Content="Nhật ký thao tác"
                        ToolTipService.ToolTip="Xem nhật ký thao tác" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,24,24">

                <!-- ============ USERS TAB ============ -->
                <StackPanel x:Name="UsersSection" Spacing="16">

                    <!-- SUMMARY STRIP -->
                    <Border Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Padding="24,16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{ThemeResource DkTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Tất cả người dùng"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TotalUsers}"
                                           FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{ThemeResource DkBorderBrush}" />

                            <StackPanel Grid.Column="2" Padding="24,16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="9" Height="9"
                                             Fill="{ThemeResource DkGreenBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Hoạt động"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveUsers}"
                                           FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                           Foreground="{ThemeResource DkGreenBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <Rectangle Grid.Column="3" Fill="{ThemeResource DkBorderBrush}" />

                            <StackPanel Grid.Column="4" Padding="24,16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="9" Height="9"
                                             Stroke="{ThemeResource DkGrayBrush}"
                                             StrokeThickness="1.5"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Đã khóa"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LockedUsers}"
                                           FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FILTER BAR -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource DkSearchBoxStyle}"
                                     PlaceholderText="Tìm theo tài khoản, họ tên hoặc vai trò"
                                     HorizontalAlignment="Stretch"
                                     TextChanged="SearchBox_TextChanged" />
                            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource FontSizeBody}"
                                      Foreground="{ThemeResource DkTextMutedBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="12,0,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <ComboBox x:Name="UserRoleFilterBox"
                                  Grid.Column="1"
                                  Width="170"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  SelectionChanged="UserRoleFilter_SelectionChanged">
                            <ComboBoxItem Content="Vai trò: Tất cả"
                                          Tag="all"
                                          IsSelected="True" />
                        </ComboBox>

                        <ComboBox x:Name="UserStatusFilterBox"
                                  Grid.Column="2"
                                  Width="170"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  SelectionChanged="UserStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="Trạng thái: Tất cả"
                                          Tag="all"
                                          IsSelected="True" />
                            <ComboBoxItem Content="Đang hoạt động"
                                          Tag="active" />
                            <ComboBoxItem Content="Đã khóa"
                                          Tag="locked" />
                        </ComboBox>

                        <Button Grid.Column="3"
                                Style="{StaticResource DkPrimaryButtonStyle}"
                                Click="AddUser_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}" />
                                <TextBlock Text="Thêm người dùng" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- USERS TABLE -->
                    <Border Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <!-- Column headers -->
                            <Border Background="{ThemeResource DkInputBgBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="11,11,0,0"
                                    Padding="24,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="NGƯỜI DÙNG" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="2" Text="VAI TRÒ" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="3" Text="QUYỀN CHỨC NĂNG" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="5" Text="THAO TÁC" Style="{StaticResource DkLabelStyle}"
                                               HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListView x:Name="UsersListView"
                                      ItemsSource="{Binding FilteredUsers}"
                                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                      ItemContainerStyle="{StaticResource UmRowItemStyle}"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UserItem">
                                        <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                MinHeight="60"
                                                Padding="24,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="2.6*" />
                                                    <ColumnDefinition Width="1.8*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind OrderNumber}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextMutedBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center" />

                                                <!-- Monogram avatar + name -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                            VerticalAlignment="Center">
                                                    <Border Width="36" Height="36"
                                                            CornerRadius="18"
                                                            Background="{ThemeResource DkBlueBgBrush}"
                                                            BorderBrush="{ThemeResource DkBlueBorderBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind views:UserManagementPage.Initials(FullName, UserName)}"
                                                                   FontSize="{StaticResource FontSizeCompact}"
                                                                   FontWeight="Bold"
                                                                   CharacterSpacing="40"
                                                                   Foreground="{ThemeResource DkBlueLightBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FullName}"
                                                                   FontSize="{StaticResource FontSizeNormal}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind UserName}"
                                                                   FontSize="{StaticResource FontSizeCompact}"
                                                                   Foreground="{ThemeResource DkTextDimBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Role as instrument tag -->
                                                <Border Grid.Column="2"
                                                        Background="{ThemeResource DkInputBgBrush}"
                                                        BorderBrush="{ThemeResource DkBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind RoleDisplay}"
                                                               Style="{StaticResource DkTagTextStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="200" />
                                                </Border>

                                                <TextBlock Grid.Column="3"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PermissionsCount}" FontWeight="SemiBold"
                                                         Foreground="{ThemeResource DkTextPrimaryBrush}" />
                                                    <Run Text="quyền" />
                                                </TextBlock>

                                                <!-- Status: marker shape + label, never color alone -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind views:UserManagementPage.StatusMarker(IsActive), Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{x:Bind views:UserManagementPage.StatusBrushFor(IsActive), Mode=OneWay}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind views:UserManagementPage.StatusBrushFor(IsActive), Mode=OneWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal" Spacing="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Chỉnh sửa"
                                                            AutomationProperties.Name="Chỉnh sửa"
                                                            Click="EditUser_Click">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontSizeSmall}" />
                                                    </Button>
                                                    <Button Style="{StaticResource DkDangerIconButtonStyle}"
                                                            ToolTipService.ToolTip="Xóa người dùng"
                                                            AutomationProperties.Name="Xóa người dùng"
                                                            Click="DeleteUser_Click">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeSmall}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty state -->
                            <TextBlock Text="Không có người dùng nào khớp với bộ lọc hiện tại"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,32"
                                       Visibility="{x:Bind views:UserManagementPage.EmptyVisibility(ViewModel.FilteredUsers.Count), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ROLES TAB ============ -->
                <StackPanel x:Name="RolesSection"
                            Spacing="16"
                            Visibility="Collapsed">

                    <!-- SUMMARY STRIP -->
                    <Border Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Padding="24,16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{ThemeResource DkTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Tất cả vai trò"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TotalRoles}"
                                           FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{ThemeResource DkBorderBrush}" />

                            <StackPanel Grid.Column="2" Padding="24,16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                               Fill="{ThemeResource DkBlueLightBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Vai trò hệ thống"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StandardRoles}"
                                           FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FILTER BAR -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="RoleSearchBox"
                                     Style="{StaticResource DkSearchBoxStyle}"
                                     PlaceholderText="Tìm theo tên hoặc mã vai trò"
                                     HorizontalAlignment="Stretch"
                                     TextChanged="RoleSearchBox_TextChanged" />
                            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource FontSizeBody}"
                                      Foreground="{ThemeResource DkTextMutedBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="12,0,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <ComboBox Grid.Column="1"
                                  Width="180"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  SelectionChanged="RoleDisplayFilter_SelectionChanged">
                            <ComboBoxItem Content="Hiển thị: Tất cả"
                                          Tag="all"
                                          IsSelected="True" />
                            <ComboBoxItem Content="Vai trò chuẩn"
                                          Tag="system" />
                            <ComboBoxItem Content="Vai trò tuỳ chỉnh"
                                          Tag="custom" />
                            <ComboBoxItem Content="Đã gán người dùng"
                                          Tag="assigned" />
                        </ComboBox>

                        <ComboBox Grid.Column="2"
                                  Width="180"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  SelectionChanged="RoleSortBox_SelectionChanged">
                            <ComboBoxItem Content="Sắp xếp: A-Z"
                                          Tag="name_asc"
                                          IsSelected="True" />
                            <ComboBoxItem Content="Sắp xếp: Z-A"
                                          Tag="name_desc" />
                            <ComboBoxItem Content="Nhiều quyền nhất"
                                          Tag="permissions_desc" />
                            <ComboBoxItem Content="Nhiều người dùng"
                                          Tag="users_desc" />
                        </ComboBox>

                        <Button Grid.Column="3"
                                Style="{StaticResource DkPrimaryButtonStyle}"
                                Click="AddRole_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}" />
                                <TextBlock Text="Thêm vai trò" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ROLES TABLE -->
                    <Border Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <Border Background="{ThemeResource DkInputBgBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="11,11,0,0"
                                    Padding="24,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="VAI TRÒ" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="2" Text="LOẠI" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="3" Text="QUYỀN" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="4" Text="NGƯỜI DÙNG" Style="{StaticResource DkLabelStyle}" />
                                    <TextBlock Grid.Column="5" Text="THAO TÁC" Style="{StaticResource DkLabelStyle}"
                                               HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListView x:Name="RolesListView"
                                      ItemsSource="{Binding FilteredRoles}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource UmRowItemStyle}"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoleItem">
                                        <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                MinHeight="60"
                                                Padding="24,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="2.6*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind OrderNumber}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextMutedBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Code}"
                                                               FontSize="{StaticResource FontSizeCompact}"
                                                               Foreground="{ThemeResource DkTextDimBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="{ThemeResource DkInputBgBrush}"
                                                        BorderBrush="{ThemeResource DkBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind KindText, Mode=OneWay}"
                                                               Style="{StaticResource DkTagTextStyle}" />
                                                </Border>

                                                <TextBlock Grid.Column="3"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{x:Bind PermissionsCount}" FontWeight="SemiBold"
                                                         Foreground="{ThemeResource DkTextPrimaryBrush}" />
                                                    <Run Text="quyền" />
                                                </TextBlock>

                                                <TextBlock Grid.Column="4"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{x:Bind UsersCount}" FontWeight="SemiBold"
                                                         Foreground="{ThemeResource DkTextPrimaryBrush}" />
                                                    <Run Text="người dùng" />
                                                </TextBlock>

                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal" Spacing="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                                            ToolTipService.ToolTip="Chỉnh sửa"
                                                            AutomationProperties.Name="Chỉnh sửa"
                                                            Click="EditRole_Click">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontSizeSmall}" />
                                                    </Button>
                                                    <Button Style="{StaticResource DkDangerIconButtonStyle}"
                                                            ToolTipService.ToolTip="Xóa vai trò"
                                                            AutomationProperties.Name="Xóa vai trò"
                                                            Click="DeleteRole_Click">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeSmall}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty state -->
                            <TextBlock Text="Không có vai trò nào khớp với bộ lọc hiện tại"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,32"
                                       Visibility="{x:Bind views:UserManagementPage.EmptyVisibility(ViewModel.FilteredRoles.Count), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
