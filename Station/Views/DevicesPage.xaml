<Page
    x:Class="Station.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.ViewModels"
    xmlns:views="using:Station.Views"
    Background="{ThemeResource DkBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý thiết bị"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Tab switcher -->
                    <Border Background="{ThemeResource DkInputBgBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="DevicesTabBtn"
                                    Style="{StaticResource DkSegmentButtonStyle}"
                                    Click="DevicesTabBtn_Click"
                                    Content="Danh sách node"/>
                            <Button x:Name="JoinRequestsTabBtn"
                                    Style="{StaticResource DkSegmentButtonStyle}"
                                    Click="JoinRequestsTabBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Yêu cầu tham gia"/>
                                    <Border Background="{ThemeResource MonitoringJoinBadgeBgBrush}"
                                            BorderBrush="{ThemeResource MonitoringJoinBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.PendingJoinSectionVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.PendingJoinCount, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeXSmall}"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource MonitoringJoinBorderBrush}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource DkSecondaryButtonStyle}" Content="Xuất báo cáo"/>
                    <Button Style="{StaticResource DkPrimaryButtonStyle}"
                            Click="AddDeviceButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Đăng ký thiết bị"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FLEET SUMMARY
             One continuous strip instead of four widget cards. Each cell carries a geometric marker
             so the category reads without color. Counts are per device (sensor, camera, radar),
             while the list below is per node. -->
        <Border x:Name="StatsPanel"
                Grid.Row="1"
                Margin="24,16,24,0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng thiết bị -->
                <StackPanel Grid.Column="0" Padding="24,16" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource DkTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tổng thiết bị"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalDevices, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{ThemeResource DkTextMutedBrush}">
                        <Run Text="thuộc"/>
                        <Run Text="{x:Bind ViewModel.FilteredNodes.Count, Mode=OneWay}"/>
                        <Run Text="node"/>
                    </TextBlock>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{ThemeResource DkBorderBrush}"/>

                <!-- Đang hoạt động -->
                <StackPanel Grid.Column="2" Padding="24,16" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="9" Height="9"
                                 Fill="{ThemeResource DkGreenBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Đang hoạt động"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.OnlineDevices, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                               Foreground="{ThemeResource DkGreenBrush}"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{ThemeResource DkBorderBrush}"/>

                <!-- Cảnh báo: amber only when there is something to look at -->
                <StackPanel Grid.Column="4" Padding="24,16" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Polygon Points="4.5,0 9,8 0,8"
                                 Fill="{ThemeResource DkYellowBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Cảnh báo"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.FaultDevices, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                               Foreground="{x:Bind views:DevicesPage.FaultCountBrush(ViewModel.FaultDevices), Mode=OneWay}"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="{ThemeResource DkBorderBrush}"/>

                <!-- Ngoại tuyến -->
                <StackPanel Grid.Column="6" Padding="24,16" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="9" Height="9"
                                 Stroke="{ThemeResource DkGrayBrush}"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Ngoại tuyến"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.OfflineDevices, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER BAR (device tab only) -->
        <Grid x:Name="DeviceFilterPanel"
              Grid.Row="2"
              Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Loại"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource DkTextMutedBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox Style="{StaticResource DkComboBoxStyle}"
                          MinWidth="150"
                          SelectedIndex="0"
                          SelectionChanged="TypeFilter_SelectionChanged">
                    <x:String>Tất cả thiết bị</x:String>
                    <x:String>Cảm biến</x:String>
                    <x:String>Camera</x:String>
                    <x:String>Radar</x:String>
                </ComboBox>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Height="20"
                       Fill="{ThemeResource DkBorderBrush}"
                       VerticalAlignment="Center" Margin="16,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Trạng thái"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource DkTextMutedBrush}"
                           VerticalAlignment="Center"/>
                <Border Background="{ThemeResource DkInputBgBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="StatusAllBtn" Tag="Tất cả"
                                Style="{StaticResource DkSegmentButtonStyle}"
                                Click="StatusFilter_Tapped"
                                Padding="12,5"
                                Content="Tất cả"/>
                        <Button x:Name="StatusOnlineBtn" Tag="Hoạt động"
                                Style="{StaticResource DkSegmentButtonStyle}"
                                Click="StatusFilter_Tapped"
                                Padding="12,5"
                                Content="Hoạt động"/>
                        <Button x:Name="StatusOfflineBtn" Tag="Ngoại tuyến"
                                Style="{StaticResource DkSegmentButtonStyle}"
                                Click="StatusFilter_Tapped"
                                Padding="12,5"
                                Content="Ngoại tuyến"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Height="20"
                       Fill="{ThemeResource DkBorderBrush}"
                       VerticalAlignment="Center" Margin="16,0"/>

            <Grid Grid.Column="4">
                <TextBox Style="{StaticResource DkSearchBoxStyle}"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Tìm theo ID, tên hoặc vị trí"
                         HorizontalAlignment="Stretch"/>
                <FontIcon Glyph="&#xE721;" FontSize="{StaticResource FontSizeBody}"
                          Foreground="{ThemeResource DkTextMutedBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="3">

            <!-- DEVICE LIST TAB -->
            <Grid x:Name="DeviceTabContent" Margin="24,16,24,24" VerticalAlignment="Top">
                <Border Background="{ThemeResource DkSurfaceBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="11,11,0,0"
                                Padding="24,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="116"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NODE" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="THIẾT BỊ GẮN KÈM" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="VỊ TRÍ" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="TRẠNG THÁI" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="4" Text="THAO TÁC" Style="{StaticResource DkLabelStyle}"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ItemsRepeater Grid.Row="1"
                                       ItemsSource="{x:Bind ViewModel.PagedFilteredNodes, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            BorderBrush="{ThemeResource DkBorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            MinHeight="60"
                                            Padding="24,10"
                                            PointerEntered="TableRow_PointerEntered"
                                            PointerExited="TableRow_PointerExited"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="116"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Node name + ID -->
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NodeName}"
                                                           FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding NodeId}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{ThemeResource DkTextDimBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Attached devices as instrument tags -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Border Visibility="{Binding CameraChipVisibility}"
                                                        Background="{ThemeResource DkInputBgBrush}"
                                                        BorderBrush="{ThemeResource DkBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,3">
                                                    <TextBlock Text="CAM" Style="{StaticResource DkTagTextStyle}"/>
                                                </Border>
                                                <Border Visibility="{Binding SensorChipVisibility}"
                                                        Background="{ThemeResource DkInputBgBrush}"
                                                        BorderBrush="{ThemeResource DkBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,3">
                                                    <TextBlock Text="{Binding SensorChipText}"
                                                               Style="{StaticResource DkTagTextStyle}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </Border>
                                                <TextBlock Visibility="{Binding UnconfiguredChipVisibility}"
                                                           Text="Chưa cấu hình"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextMutedBrush}"/>
                                            </StackPanel>

                                            <!-- Location -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Location}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Status: marker shape + label, never color alone -->
                                            <Border Grid.Column="3"
                                                    Background="{Binding StatusBackgroundColor}"
                                                    BorderBrush="{Binding StatusColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="9,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding StatusMarker}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{Binding StatusColor}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusColor}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Row actions -->
                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal" Spacing="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource DkIconButtonStyle}"
                                                        ToolTipService.ToolTip="Xem chi tiết"
                                                        AutomationProperties.Name="Xem chi tiết"
                                                        Tag="{Binding}"
                                                        Click="ViewDetails_Click">
                                                    <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource FontSizeSmall}"/>
                                                </Button>
                                                <Button Style="{StaticResource DkIconButtonStyle}"
                                                        ToolTipService.ToolTip="Chỉnh sửa"
                                                        AutomationProperties.Name="Chỉnh sửa"
                                                        Tag="{Binding}"
                                                        Click="EditButton_Click">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource FontSizeSmall}"/>
                                                </Button>
                                                <Button Style="{StaticResource DkDangerIconButtonStyle}"
                                                        ToolTipService.ToolTip="Xóa node"
                                                        AutomationProperties.Name="Xóa node"
                                                        Tag="{Binding}"
                                                        Click="DeleteButton_Click">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeSmall}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="2"
                                   Text="Không có node nào khớp với bộ lọc hiện tại"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,32"
                                   Visibility="{x:Bind ViewModel.NoNodesVisibility, Mode=OneWay}"/>

                        <!-- Footer -->
                        <Border Grid.Row="3"
                                Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,11,11"
                                Padding="24,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind ViewModel.PageFooterText, Mode=OneWay}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextMutedBrush}"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                            AutomationProperties.Name="Trang trước"
                                            Command="{x:Bind ViewModel.PrevPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanGoPrevPage, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE76B;" FontSize="{StaticResource FontSizeCompact}"/>
                                    </Button>
                                    <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center">
                                        <Run Text="Trang"/>
                                        <Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Style="{StaticResource DkIconButtonStyle}"
                                            AutomationProperties.Name="Trang sau"
                                            Command="{x:Bind ViewModel.NextPageCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanGoNextPage, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource FontSizeCompact}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- JOIN REQUESTS TAB -->
            <ScrollViewer x:Name="JoinTabContent"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <Grid Margin="24,16,24,24">
                    <Border Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="24,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Polygon Points="4.5,0 9,8 0,8"
                                                 Fill="{ThemeResource DkYellowBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Yêu cầu chờ xử lý"
                                                   FontSize="{StaticResource FontSizeNormal}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.PendingJoinLastUpdatedDisplay, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Column headers -->
                            <Border Grid.Row="1"
                                    Background="{ThemeResource DkInputBgBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="24,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="THIẾT BỊ" Style="{StaticResource DkLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="FIRMWARE" Style="{StaticResource DkLabelStyle}"/>
                                    <TextBlock Grid.Column="2" Text="HARDWARE ID" Style="{StaticResource DkLabelStyle}"/>
                                    <TextBlock Grid.Column="3" Text="ĐỊA CHỈ IP / MAC" Style="{StaticResource DkLabelStyle}"/>
                                    <TextBlock Grid.Column="4" Text="NODE ID" Style="{StaticResource DkLabelStyle}"/>
                                    <TextBlock Grid.Column="5" Text="THAO TÁC" Style="{StaticResource DkLabelStyle}"/>
                                </Grid>
                            </Border>

                            <!-- Rows -->
                            <ItemsRepeater Grid.Row="2"
                                           ItemsSource="{x:Bind ViewModel.PendingJoinRequests, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="{ThemeResource DkBorderSubtleBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="24,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}"
                                                               FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DeviceType}"
                                                               FontSize="{StaticResource FontSizeCompact}"
                                                               Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FirmwareDisplay}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding HardwareIdHex}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding IpAddressDisplay}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Text="{Binding MacAddressDisplay}"
                                                               FontSize="{StaticResource FontSizeCompact}"
                                                               Foreground="{ThemeResource DkTextMutedBrush}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>

                                                <TextBox Grid.Column="4"
                                                         Text="{Binding NodeByteIdInput, Mode=TwoWay}"
                                                         PlaceholderText="ID"
                                                         FontSize="{StaticResource FontSizeSmall}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Stretch"
                                                         Margin="0,0,12,0"
                                                         Style="{StaticResource DkSearchBoxStyle}"
                                                         Padding="10,8"/>

                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal" Spacing="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding RejectCommand}"
                                                            IsEnabled="{Binding IsNotProcessing}"
                                                            Style="{StaticResource DkSecondaryButtonStyle}"
                                                            Padding="14,6"
                                                            Content="Từ chối"/>
                                                    <Button Command="{Binding ApproveCommand}"
                                                            IsEnabled="{Binding IsNotProcessing}"
                                                            Style="{StaticResource DkPrimaryButtonStyle}"
                                                            Padding="14,6"
                                                            Content="Phê duyệt"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Empty state -->
                            <TextBlock Grid.Row="3"
                                       Text="Không có yêu cầu nào đang chờ xử lý"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,32"
                                       Visibility="{x:Bind ViewModel.NoPendingJoinVisibility, Mode=OneWay}"/>

                            <!-- Footer: summary only, no placeholder pagination -->
                            <Border Grid.Row="4"
                                    Background="{ThemeResource DkInputBgBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,11,11"
                                    Padding="24,12">
                                <TextBlock Text="{x:Bind ViewModel.PendingJoinFooterText, Mode=OneWay}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextMutedBrush}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
