<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Station.Views.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource DkBgBrush}">

    <Grid>
        <!-- Responsive: collapse to one column on narrow windows -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumnDefinition.Width" Value="0"/>
                        <Setter Target="LeftColumnDefinition.Width" Value="1*"/>
                        <Setter Target="RightPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="RightPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="RightPanel.Margin" Value="0,20,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Cấu hình trạm"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                <TextBlock Text="Thiết lập thông tin trạm giám sát và kết nối trung tâm hệ thống"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{ThemeResource DkTextMutedBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid x:Name="MainContentGrid" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumnDefinition" Width="6*"/>
                    <ColumnDefinition x:Name="RightColumnDefinition" Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LEFT: station and contact -->
                <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Spacing="20">
                    <Border Background="{ThemeResource DkSurfaceBrush}" CornerRadius="12" BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Thông tin cơ bản" FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            <Rectangle Height="1" Fill="{ThemeResource DkBorderBrush}" Margin="0,-8,0,0"/>
                            <Grid RowSpacing="20" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Mã trạm" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                        <TextBlock Text="*" Foreground="{ThemeResource DkRedBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.StationCode, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Tên trạm" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                        <TextBlock Text="*" Foreground="{ThemeResource DkRedBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.StationName, Mode=TwoWay}" PlaceholderText="VD: Trạm giám sát 01"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="1" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Khu vực" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                        <TextBlock Text="*" Foreground="{ThemeResource DkRedBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.Area, Mode=TwoWay}" PlaceholderText="VD: Miền Bắc"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Tuyến" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                        <TextBlock Text="*" Foreground="{ThemeResource DkRedBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.Route, Mode=TwoWay}" PlaceholderText="VD: Tuyến 1A"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource DkSurfaceBrush}" CornerRadius="12" BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Thông tin liên hệ" FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            <Rectangle Height="1" Fill="{ThemeResource DkBorderBrush}" Margin="0,-8,0,0"/>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Người phụ trách" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.ContactPerson, Mode=TwoWay}" PlaceholderText="Họ và tên"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Số điện thoại / Hotline" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" PlaceholderText="0123 456 789"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: connection, guidance, save -->
                <StackPanel x:Name="RightPanel" Grid.Column="1" Grid.Row="0" Spacing="20">
                    <Border Background="{ThemeResource DkSurfaceBrush}" CornerRadius="12" BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Cấu hình kết nối" FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            <Rectangle Height="1" Fill="{ThemeResource DkBorderBrush}" Margin="0,-8,0,0"/>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="URL Trung tâm" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                        <TextBlock Text="*" Foreground="{ThemeResource DkRedBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Style="{StaticResource DkSearchBoxStyle}" Padding="12,8" MinHeight="40" Text="{x:Bind ViewModel.CenterUrl, Mode=TwoWay}" PlaceholderText="https://center-server.com:5000"/>
                                </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Guidance -->
                    <Border Background="{ThemeResource DkInputBgBrush}" BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="HƯỚNG DẪN THIẾT LẬP" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource DkTextSecondaryBrush}" LineHeight="22">
                                <Run Text="Các trường có dấu "/>
                                <Run Text="*" Foreground="{ThemeResource DkRedBrush}" FontWeight="Bold"/>
                                <Run Text=" là bắt buộc nhập."/>
                                <LineBreak/>
                                <Run Text="URL Trung tâm" FontWeight="SemiBold" Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                                <Run Text=" phải bắt đầu bằng http:// hoặc https://"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Feedback -->
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="SuccessInfoBar" IsOpen="{x:Bind ViewModel.HasSuccessMessage, Mode=OneWay}" Severity="Success" Title="Thành công" Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" IsClosable="True" CornerRadius="8"/>
                        <InfoBar x:Name="ErrorInfoBar" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="Đã có lỗi xảy ra" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="True" CornerRadius="8"/>
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <ProgressRing IsActive="True" Width="24" Height="24"/>
                        <TextBlock Text="Đang xử lý..." FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource DkTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource DkPrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.SaveConfigurationCommand}"
                            HorizontalAlignment="Stretch"
                            MinHeight="42"
                            Content="Lưu cấu hình"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
