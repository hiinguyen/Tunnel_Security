<Page
    x:Class="Station.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource DkBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- BRAND PANEL: deeper tonal step, no gradient -->
        <Border Grid.Column="0"
                Background="{ThemeResource DkInputBgBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="56,48">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel MaxWidth="520"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="20">
                    <TextBlock Text="TRUNG TÂM ĐIỀU HÀNH"
                               Foreground="{ThemeResource DkTextMutedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="Bold"
                               CharacterSpacing="140"/>

                    <TextBlock Text="Hệ thống&#x0a;giám sát cống ngầm"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               FontSize="40"
                               FontWeight="SemiBold"
                               LineHeight="48"/>

                    <TextBlock Text="Giám sát vận hành, cảnh báo sự cố và điều phối trạm theo thời gian thực."
                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeMedium}"
                               TextWrapping="Wrap"/>

                    <!-- Instrument tags: the same vocabulary used across the console -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Border Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="SEN" Style="{StaticResource DkTagTextStyle}"/>
                        </Border>
                        <Border Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="CAM" Style="{StaticResource DkTagTextStyle}"/>
                        </Border>
                        <Border Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="RAD" Style="{StaticResource DkTagTextStyle}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Foreground="{ThemeResource DkTextDimBrush}"
                           FontSize="{StaticResource FontSizeCompact}"
                           Text="Tunnel Security Station - phiên bản vận hành nội bộ"/>
            </Grid>
        </Border>

        <!-- FORM -->
        <Grid Grid.Column="1" Padding="48">
            <Border MaxWidth="440"
                    MinWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DkSurfaceBrush}"
                    BorderBrush="{ThemeResource DkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Đăng nhập hệ thống"
                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLarge}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Sử dụng tài khoản được cấp để truy cập trung tâm điều hành."
                                   Foreground="{ThemeResource DkTextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <controls:InfoBar x:Name="ErrorInfoBar"
                                      IsOpen="False"
                                      IsClosable="True"
                                      Severity="Error"
                                      Title="Đăng nhập không thành công"
                                      CornerRadius="8"/>

                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="TÀI KHOẢN" Style="{StaticResource DkLabelStyle}"/>
                            <TextBox x:Name="UsernameBox"
                                     PlaceholderText="Nhập tài khoản"
                                     MinHeight="40"
                                     Background="{ThemeResource DkInputBgBrush}"
                                     Foreground="{ThemeResource DkTextPrimaryBrush}"
                                     PlaceholderForeground="{ThemeResource DkTextMutedBrush}"
                                     BorderBrush="{ThemeResource DkBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     FontSize="{StaticResource FontSizeNormal}"
                                     VerticalContentAlignment="Center"
                                     Padding="12,8"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="MẬT KHẨU" Style="{StaticResource DkLabelStyle}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         PlaceholderText="Nhập mật khẩu"
                                         MinHeight="40"
                                         Background="{ThemeResource DkInputBgBrush}"
                                         Foreground="{ThemeResource DkTextPrimaryBrush}"
                                         BorderBrush="{ThemeResource DkBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         FontSize="{StaticResource FontSizeNormal}"
                                         VerticalContentAlignment="Center"
                                         Padding="12,8"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Button x:Name="LoginButton"
                                Click="LoginButton_Click"
                                Content="Đăng nhập"
                                Style="{StaticResource DkPrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinHeight="42"/>

                        <ProgressRing x:Name="LoadingRing"
                                      Width="26"
                                      Height="26"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
