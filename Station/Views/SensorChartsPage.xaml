<Page
    x:Class="Station.Views.SensorChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource DkBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Giám sát cảm biến"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Connection state: marker + text, never color alone -->
                    <Border Background="{ThemeResource DkInputBgBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="ConnectionDot" Width="9" Height="9"
                                         Fill="{ThemeResource DkConnectionOfflineBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnectionText" Text="ĐANG KẾT NỐI"
                                           Style="{StaticResource DkTagTextStyle}"
                                           Foreground="{ThemeResource DkConnectionOfflineBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="16" Fill="{ThemeResource DkBorderBrush}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="CẢM BIẾN" Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SensorCountText" Text="0"
                                           FontSize="{StaticResource FontSizeNormal}" FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="CẬP NHẬT" Style="{StaticResource DkLabelStyle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TotalUpdatesText" Text="0"
                                           FontSize="{StaticResource FontSizeNormal}" FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="ClearHistory_Click" Style="{StaticResource DkSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="Xóa lịch sử"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{ThemeResource DkSurfaceBrush}"
                    BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,20,0,4">
                        <TextBlock Text="BỐ CỤC" Style="{StaticResource DkLabelStyle}" Margin="24,0,24,10"/>

                        <Border x:Name="LayoutOpt1" Tag="1" IsTapEnabled="True"
                                Tapped="LayoutOption_Tapped" Padding="10,8" Margin="12,0,12,2"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="18" Height="12" VerticalAlignment="Center">
                                    <Rectangle Fill="{ThemeResource DkTextSecondaryBrush}" RadiusX="1" RadiusY="1"/>
                                </Grid>
                                <TextBlock x:Name="LblLayout1" Text="1 cột" FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource DkTextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LayoutOpt2" Tag="2" IsTapEnabled="True"
                                Tapped="LayoutOption_Tapped" Padding="10,8" Margin="12,0,12,2"
                                Background="{ThemeResource DkBlueBgBrush}" BorderThickness="1"
                                BorderBrush="{ThemeResource DkBlueLightBrush}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="18" Height="12" VerticalAlignment="Center" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{ThemeResource DkBlueLightBrush}" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Column="1" Fill="{ThemeResource DkBlueLightBrush}" RadiusX="1" RadiusY="1"/>
                                </Grid>
                                <TextBlock x:Name="LblLayout2" Text="2 cột" FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource DkBlueLightBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LayoutOpt3" Tag="3" IsTapEnabled="True"
                                Tapped="LayoutOption_Tapped" Padding="10,8" Margin="12,0,12,2"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="18" Height="12" VerticalAlignment="Center" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{ThemeResource DkTextSecondaryBrush}" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Column="1" Fill="{ThemeResource DkTextSecondaryBrush}" RadiusX="1" RadiusY="1"/>
                                    <Rectangle Grid.Column="2" Fill="{ThemeResource DkTextSecondaryBrush}" RadiusX="1" RadiusY="1"/>
                                </Grid>
                                <TextBlock x:Name="LblLayout3" Text="3 cột" FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource DkTextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Rectangle Height="1" Fill="{ThemeResource DkBorderSubtleBrush}" Margin="0,12,0,16"/>
                        <TextBlock Text="DANH SÁCH CẢM BIẾN" Style="{StaticResource DkLabelStyle}" Margin="24,0,24,4"/>
                        <TextBlock Text="Kéo cảm biến vào ô trống để hiển thị"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   TextWrapping="Wrap" Margin="24,0,24,10"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SensorListPanel" Margin="0,0,0,12"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CHARTS AREA (named: the FLIP fullscreen transform measures against it) -->
            <Grid x:Name="ChartsAreaRoot" Grid.Column="1" Background="{ThemeResource DkBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Charts toolbar -->
                <Border Grid.Row="0" Padding="24,12"
                        BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="ChartsTitleText" Text="Bảng điều khiển cảm biến"
                                       FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            <Border Background="{ThemeResource DkInputBgBrush}"
                                    BorderBrush="{ThemeResource DkBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="ChartCountBadge" Text="0 / 0 hiển thị"
                                           Style="{StaticResource DkTagTextStyle}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Lịch sử (điểm)" FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextMutedBrush}" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource DkInputBgBrush}"
                                        BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="2">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Border x:Name="HistOpt30" Tag="30" IsTapEnabled="True"
                                                Tapped="HistoryOption_Tapped" Padding="12,5" CornerRadius="6"
                                                Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                            <TextBlock x:Name="HistLbl30" Text="30" FontSize="{StaticResource FontSizeSmall}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                                        </Border>
                                        <Border x:Name="HistOpt60" Tag="60" IsTapEnabled="True"
                                                Tapped="HistoryOption_Tapped" Padding="12,5" CornerRadius="6"
                                                Background="{ThemeResource DkBlueBgBrush}" BorderThickness="0" BorderBrush="Transparent">
                                            <TextBlock x:Name="HistLbl60" Text="60" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{ThemeResource DkBlueLightBrush}"/>
                                        </Border>
                                        <Border x:Name="HistOpt100" Tag="100" IsTapEnabled="True"
                                                Tapped="HistoryOption_Tapped" Padding="12,5" CornerRadius="6"
                                                Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                                            <TextBlock x:Name="HistLbl100" Text="100" FontSize="{StaticResource FontSizeSmall}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Button x:Name="AutoFillButton" Click="AutoFill_Click"
                                    Style="{StaticResource DkSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Tự động lấp đầy ô trống">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontSizeSmall}"/>
                                    <TextBlock Text="Lấp đầy"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Charts grid: fixed Row/Column cells, cards span whole cells -->
                <Border Grid.Row="1" Padding="24,16">
                    <Grid x:Name="ChartsHost" ColumnSpacing="16" RowSpacing="16"/>
                </Border>

                <!-- Empty state: text and an instrument tag, no pictogram -->
                <StackPanel x:Name="EmptyState" Grid.Row="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="12" Visibility="Visible">
                    <Border Background="{ThemeResource DkInputBgBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,3"
                            HorizontalAlignment="Center">
                        <TextBlock Text="CHỜ DỮ LIỆU" Style="{StaticResource DkTagTextStyle}"/>
                    </Border>
                    <TextBlock x:Name="EmptyStateLabel" Text="Đang kết nối..."
                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextSecondaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="Đang chờ luồng dữ liệu cảm biến"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{ThemeResource DkTextMutedBrush}" TextAlignment="Center"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="24,10" Background="{ThemeResource DkSurfaceBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                           Fill="{ThemeResource DkTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Cảm biến đã gán" FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextMutedBrush}"/>
                                <TextBlock x:Name="TotalNodesText" Text="0" FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                                           Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkYellowBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Cảnh báo" FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextMutedBrush}"/>
                                <TextBlock x:Name="ActiveAlertsText" Text="0" FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                                           Foreground="{ThemeResource DkYellowBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Kéo cảm biến từ danh sách để hiển thị"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Fullscreen chart overlay: hosts the same card Border re-parented from ChartsHost.
                     CompositeTransform anchors at the element's top-left, which the FLIP math in
                     PlayFullscreenTransition() assumes. Do not add RenderTransformOrigin. -->
                <Grid x:Name="FullscreenOverlay" Grid.Row="0" Grid.RowSpan="3"
                      Background="{ThemeResource DkScrimBrush}" Padding="28"
                      Visibility="Collapsed" Opacity="0">
                    <Grid x:Name="FullscreenCardHost">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="FullscreenCardTransform"/>
                        </Grid.RenderTransform>
                    </Grid>
                    <Button Click="FullscreenClose_Click"
                            Style="{StaticResource DkIconButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            AutomationProperties.Name="Thu nhỏ"
                            ToolTipService.ToolTip="Thu nhỏ">
                        <FontIcon Glyph="&#xE73F;" FontSize="{StaticResource FontSizeSubtitle}"/>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>
