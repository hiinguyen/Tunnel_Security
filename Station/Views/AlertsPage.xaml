<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Station.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Station.ViewModels"
    xmlns:views="using:Station.Views"
    xmlns:conv="using:Station.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="{ThemeResource DkBgBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <conv:ZeroToVisibilityConverter  x:Key="ZeroToVisibilityConverter"/>
        <!-- Suppress default ListView/ListViewItem background -->
        <SolidColorBrush x:Key="ListViewItemBackground"              Color="Transparent"/>
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected"      Color="Transparent"/>
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"   Color="Transparent"/>
        <SolidColorBrush x:Key="ListViewBackground"                  Color="Transparent"/>
        <SolidColorBrush x:Key="ListViewBorderBrush"                 Color="Transparent"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý cảnh báo và sự cố"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Hiện tại / Lịch sử -->
                    <Border Background="{ThemeResource DkInputBgBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="CurrentViewButton"
                                    Style="{StaticResource DkSegmentButtonStyle}"
                                    Click="CurrentViewButton_Click"
                                    Content="Hiện tại"/>
                            <Button x:Name="HistoryViewButton"
                                    Style="{StaticResource DkSegmentButtonStyle}"
                                    Click="HistoryViewButton_Click"
                                    Content="Lịch sử"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource DkSecondaryButtonStyle}"
                        Click="ExportCsvButton_Click"
                        ToolTipService.ToolTip="Xuất CSV"
                        Content="Xuất CSV"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,16,24,24" Spacing="16">

                <!-- SEVERITY SUMMARY: one strip, each cell carries a geometric marker -->
                <Border Background="{ThemeResource DkSurfaceBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nghiêm trọng -->
                        <StackPanel Grid.Column="0" Padding="24,16" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                           Fill="{ThemeResource DkRedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Nghiêm trọng"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CriticalCount, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                       Foreground="{x:Bind views:AlertsPage.CriticalCountBrush(ViewModel.CriticalCount), Mode=OneWay}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="cảnh báo nguy cấp"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Fill="{ThemeResource DkBorderBrush}"/>

                        <!-- Cảnh báo -->
                        <StackPanel Grid.Column="2" Padding="24,16" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Polygon Points="4.5,0 9,8 0,8"
                                         Fill="{ThemeResource DkYellowBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Cảnh báo"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WarningCount, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                       Foreground="{x:Bind views:AlertsPage.WarningCountBrush(ViewModel.WarningCount), Mode=OneWay}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="mức cao và trung bình"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Fill="{ThemeResource DkBorderBrush}"/>

                        <!-- Thông tin -->
                        <StackPanel Grid.Column="4" Padding="24,16" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9"
                                         Fill="{ThemeResource DkTextSecondaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Thông tin"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LowCount, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeXXLarge}" FontWeight="Bold"
                                       Foreground="{ThemeResource DkTextPrimaryBrush}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="mức thấp"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FILTER BAR -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Mức độ"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource DkComboBoxStyle}"
                                  MinWidth="140"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Bind ViewModel.Severities}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSeverity, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Trạng thái"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource DkComboBoxStyle}"
                                  MinWidth="140"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Bind ViewModel.Statuses}"
                                  SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Loại"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource DkComboBoxStyle}"
                                  MinWidth="150"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Bind ViewModel.Categories}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"/>
                    </StackPanel>

                    <Grid Grid.Column="3">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource DkSearchBoxStyle}"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Tìm trạm, mô tả, nút..."
                                 HorizontalAlignment="Stretch"/>
                        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource FontSizeBody}"
                                  Foreground="{ThemeResource DkTextMutedBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="12,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Style="{StaticResource DkIconButtonStyle}"
                                Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Làm mới"
                                AutomationProperties.Name="Làm mới">
                            <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource FontSizeSmall}"/>
                        </Button>
                        <Button Style="{StaticResource DkIconButtonStyle}"
                                Click="ClearFiltersButton_Click"
                                ToolTipService.ToolTip="Xóa bộ lọc"
                                AutomationProperties.Name="Xóa bộ lọc">
                            <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontSizeSmall}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ALERT TABLE -->
                <Border Background="{ThemeResource DkSurfaceBrush}"
                        BorderBrush="{ThemeResource DkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <!-- Column headers -->
                        <Border Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="11,11,0,0"
                                Padding="24,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MỨC ĐỘ" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="LOẠI SỰ CỐ" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="VỊ TRÍ (TUYẾN VÀ NÚT)" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="THỜI GIAN" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource DkLabelStyle}"/>
                                <TextBlock Grid.Column="5" Text="THAO TÁC" Style="{StaticResource DkLabelStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ListView x:Name="AlertListView"
                                  ItemsSource="{x:Bind ViewModel.FilteredAlerts, Mode=OneWay}"
                                  SelectionMode="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AlertItemViewModel">
                                    <Grid Padding="24,12"
                                          MinHeight="60"
                                          BorderBrush="{ThemeResource DkBorderSubtleBrush}"
                                          BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity: marker shape + label -->
                                        <Border Grid.Column="0"
                                                Background="{x:Bind views:AlertsPage.SeverityBgBrush(Severity)}"
                                                BorderBrush="{x:Bind views:AlertsPage.SeverityBrush(Severity)}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="9,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{x:Bind views:AlertsPage.SeverityMarker(Severity)}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{x:Bind views:AlertsPage.SeverityBrush(Severity)}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SeverityText}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{x:Bind views:AlertsPage.SeverityBrush(Severity)}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Title + category -->
                                        <StackPanel Grid.Column="1" Spacing="2"
                                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding CategoryText}"
                                                       FontSize="{StaticResource FontSizeCompact}"
                                                       Foreground="{ThemeResource DkTextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Location -->
                                        <StackPanel Grid.Column="2" Spacing="2"
                                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding LineName}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding NodeName}"
                                                       FontSize="{StaticResource FontSizeCompact}"
                                                       Foreground="{ThemeResource DkTextDimBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Time -->
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedAtFormatted}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding TimeAgo}"
                                                       FontSize="{StaticResource FontSizeCompact}"
                                                       Foreground="{ThemeResource DkTextDimBrush}"/>
                                        </StackPanel>

                                        <!-- State: marker shape + label -->
                                        <Border Grid.Column="4"
                                                Background="{x:Bind views:AlertsPage.StateBgBrush(State), Mode=OneWay}"
                                                BorderBrush="{x:Bind views:AlertsPage.StateBrush(State), Mode=OneWay}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="9,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{x:Bind views:AlertsPage.StateMarker(State), Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{x:Bind views:AlertsPage.StateBrush(State), Mode=OneWay}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StateText}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{x:Bind views:AlertsPage.StateBrush(State), Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Content="Xác nhận"
                                                    Tag="{Binding}"
                                                    Click="AcknowledgeRowButton_Click"
                                                    Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource DkPrimaryButtonStyle}"
                                                    Padding="12,6" MinHeight="32"/>
                                            <Button Content="Chi tiết"
                                                    Tag="{Binding}"
                                                    Click="DetailRowButton_Click"
                                                    Style="{StaticResource DkSecondaryButtonStyle}"
                                                    Padding="12,6" MinHeight="32"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state -->
                        <Border x:Name="EmptyStatePanel"
                                Visibility="{x:Bind ViewModel.FilteredCount, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"
                                Padding="40,32">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="Không có cảnh báo nào khớp với bộ lọc hiện tại"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{ThemeResource DkTextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Đổi hoặc xóa bộ lọc để xem thêm kết quả"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource DkTextDimBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Footer -->
                        <Border Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,11,11"
                                Padding="24,10">
                            <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource DkTextMutedBrush}"
                                       Typography.NumeralAlignment="Tabular">
                                <Run Text="Hiển thị"/>
                                <Run Text="{x:Bind ViewModel.FilteredCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{x:Bind ViewModel.TotalAlerts, Mode=OneWay}"/>
                                <Run Text="cảnh báo"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TREND + SUMMARY -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Xu hướng cảnh báo (7 ngày)"
                                       FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                            <lvc:CartesianChart Series="{x:Bind ViewModel.AlertTrendSeries, Mode=OneTime}"
                                                XAxes="{x:Bind ViewModel.AlertTrendXAxes, Mode=OneTime}"
                                                YAxes="{x:Bind ViewModel.AlertTrendYAxes, Mode=OneTime}"
                                                Height="160"
                                                Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{ThemeResource DkSurfaceBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Thống kê tổng hợp"
                                       FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource DkTextPrimaryBrush}"/>

                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkRedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chưa xử lý" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.UnprocessedCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="9" Height="9" Stroke="{ThemeResource DkBlueLightBrush}"
                                                 StrokeThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đã xác nhận" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.AcknowledgedCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkYellowBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đang xử lý" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.InProgressCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="9" Height="9" Fill="{ThemeResource DkGreenBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đã giải quyết" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.ResolvedCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource DkBorderBrush}"/>

                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hôm nay" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.TodayCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="7 ngày qua" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.WeekCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="30 ngày qua" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource DkTextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.MonthCount, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
