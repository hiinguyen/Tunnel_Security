<Page
    x:Class="Station.Views.MonitoringDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Station.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls2="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Station.Views"
    mc:Ignorable="d"
    Background="{ThemeResource DkDeepBrush}">

    <Page.DataContext>
        <viewmodels:MonitoringDashboardViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!-- Red pulse overlay — loops until dismissed -->
        <Storyboard x:Name="RedFlashStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="RedFlashOverlay"
                Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0"/>
                <LinearDoubleKeyFrame   KeyTime="0:0:0.150" Value="0.50"/>
                <LinearDoubleKeyFrame   KeyTime="0:0:0.550" Value="0.35"/>
                <LinearDoubleKeyFrame   KeyTime="0:0:0.900" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.600" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <!-- Outer container — content + overlay layers -->
    <Grid>

    <!-- ─── MAIN CONTENT ─── -->
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300" MinHeight="220"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Station Name and Status -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="TRM-HN-001"
                           FontFamily="Segoe UI Variable"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                <Border Background="{ThemeResource SeverityLowLightBrush}"
                        BorderBrush="{ThemeResource SeverityLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityLowBrush}"/>
                        <TextBlock Text="Đã kết nối"
                                   FontSize="12"
                                   Foreground="{ThemeResource SeverityLowBrush}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center - Station Name -->
            <TextBlock Grid.Column="1"
                       Text="Trạm Nghĩa Đô"
                       FontFamily="Segoe UI Variable"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Right - Time, User, Settings -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                           VerticalAlignment="Center">
                    <Run Text="{x:Bind ViewModel.CurrentDate, Mode=OneWay}"/>
                    <Run Text="  "/>
                    <Run Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"/>
                </TextBlock>
                <Button x:Name="UserManagementHeaderButton"
                        Click="AdminButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        AutomationProperties.Name="Tài khoản / Quản trị"
                        ToolTipService.ToolTip="Tài khoản / Quản trị"
                        VerticalAlignment="Center">

                    <FontIcon Glyph="&#xE716;"
                              FontSize="20"
                              Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                </Button>

                <Button x:Name="ThemeToggleButton"
                        Click="ThemeToggleButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        AutomationProperties.Name="Chuyển đổi chế độ sáng/tối"
                        ToolTipService.ToolTip="Chuyển đổi chế độ sáng/tối"
                        VerticalAlignment="Center">
                    <Grid>
                        <FontIcon x:Name="MoonIcon"
                                  Glyph="&#xE708;"
                                  FontSize="20"
                                  Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                  Visibility="Visible"/>
                        <FontIcon x:Name="SunIcon"
                                  Glyph="&#xE706;"
                                  FontSize="20"
                                  Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                  Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button x:Name="ConfigurationButton"
                        Click="ConfigurationButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        AutomationProperties.Name="Cấu hình"
                        ToolTipService.ToolTip="Cấu hình"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;"
                              FontSize="20"
                              Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                </Button>
                <Button x:Name="AccountButton"
                        Background="{ThemeResource MonitoringPanelBackgroundBrush}"
                        BorderBrush="{ThemeResource MonitoringBorderBrush}"
                        BorderThickness="1"
                        Padding="8,6,12,6"
                        CornerRadius="8"
                        ToolTipService.ToolTip="Tài khoản"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Border MinWidth="250"
                                    Background="{ThemeResource MonitoringPanelBackgroundBrush}"
                                    BorderBrush="{ThemeResource MonitoringBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Tùy chọn tài khoản"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>

                                    <Button Click="AccountInfoButton_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE77B;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                            <TextBlock Text="Thông tin tài khoản"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="LogoutButton_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8AC;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource SeverityCriticalBrush}"/>
                                            <TextBlock Text="Đăng xuất"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource SeverityCriticalBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!-- Monogram from the signed-in user's name (set in ApplyCurrentUserSession) -->
                        <Border Width="28" Height="28"
                                CornerRadius="6"
                                Background="{ThemeResource MonitoringBackgroundBrush}"
                                BorderBrush="{ThemeResource MonitoringBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderAvatarText"
                                       Text="?"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       CharacterSpacing="40"
                                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Spacing="0"
                                    VerticalAlignment="Center"
                                    MaxWidth="150">
                            <TextBlock x:Name="HeaderUserNameText"
                                       Text="Tài khoản"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HeaderRoleText"
                                       Text="Phiên đăng nhập"
                                       FontSize="11"
                                       Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <FontIcon Glyph="&#xE70D;"
                                  FontSize="12"
                                  Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Right Panel - Phân tích & thống kê (Single Panel) -->
            <Border Grid.Column="4"
                    Background="{ThemeResource MonitoringPanelBackgroundBrush}"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Header with hamburger menu-->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Phân tích &amp; thống kê"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                            <TextBlock Text="Tổng quan cảnh báo của trạm"
                                       FontSize="11"
                                       Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button x:Name="ErrorNodesMenuButton"
                                Click="TrendPanelMenuButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Mở cửa sổ phân tích"
                                ToolTipService.ToolTip="Mở cửa sổ phân tích">
                            <FontIcon Glyph="&#xE8A7;"
                                      FontSize="16"
                                      Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!--Content: KPI strip + trend + top sources, same card language as the Analytics page-->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!--KPI strip: 2x2 cells split by hairlines-->
                            <Border Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Grid.Row="0" Padding="14,12" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tổng cảnh báo" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.TodayAlerts, Mode=OneWay}" FontSize="24" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="{ThemeResource MonitoringBorderBrush}"/>
                                    <StackPanel Grid.Column="2" Grid.Row="0" Padding="14,12" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="9" Height="9" Fill="{ThemeResource SeverityLowBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đã xử lý" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.ResolvedAlerts, Mode=OneWay}" FontSize="24" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{ThemeResource MonitoringBorderBrush}"/>
                                    <StackPanel Grid.Column="0" Grid.Row="2" Padding="14,12" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource SeverityMediumBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tỷ lệ xử lý" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.ResolvedRateText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="2" Padding="14,12" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{ThemeResource MonitoringAccentButtonBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xử lý trung bình" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.AvgHandleTimeText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--Top sources card-->
                            <Border Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel>
                                        <TextBlock Text="Top nguồn phát sinh cảnh báo" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                        <TextBlock Text="Sensor, camera, radar có số cảnh báo cao nhất" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ErrorNodesChart" Spacing="8">
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SEN-002" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45*"/>
                                                        <ColumnDefinition Width="0*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityCriticalBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="45" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CAM-004" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36*"/>
                                                        <ColumnDefinition Width="9*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityHighBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="36" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="RAD-001" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28*"/>
                                                        <ColumnDefinition Width="17*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityMediumBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="28" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SEN-005" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24*"/>
                                                        <ColumnDefinition Width="21*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityMediumBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="24" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SEN-001" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18*"/>
                                                        <ColumnDefinition Width="27*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityLowBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="18" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CAM-002" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="15*"/>
                                                        <ColumnDefinition Width="30*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityLowBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="15" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SEN-003" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12*"/>
                                                        <ColumnDefinition Width="33*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityLowBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="12" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CAM-001" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="9*"/>
                                                        <ColumnDefinition Width="36*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityLowBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="9" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="RAD-002" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="39*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityLowBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="6" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SEN-006" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="42*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource SeverityLowBrush}" CornerRadius="4"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="3" FontSize="11" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <!--Severity legend-->
                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="8" Height="8" Fill="{ThemeResource SeverityCriticalBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Nghiêm trọng" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="8" Height="8" Fill="{ThemeResource SeverityHighBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Cao" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="8" Height="8" Fill="{ThemeResource SeverityMediumBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Trung bình" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="8" Height="8" Fill="{ThemeResource SeverityLowBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thấp" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- GridSplitter between Left and Center panels -->
            <controls2:GridSplitter Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"

                                    Background="Transparent"
                                    ResizeBehavior="PreviousAndNext">
                <controls2:GridSplitter.RenderTransform>
                    <TranslateTransform X="-0" />
                </controls2:GridSplitter.RenderTransform>

            </controls2:GridSplitter>

            <!-- Center Panel - Security Map -->
            <Border Grid.Column="2"
                    Background="{ThemeResource DkDeepBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Bản đồ tuyến cống"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <!-- WebView2 for Interactive Map -->
                    <Border Grid.Row="1"
                            CornerRadius="6"
                            Background="{ThemeResource DkDeepBrush}"
                            >
                        <controls:WebView2 x:Name="SecurityMapWebView"
                                           DefaultBackgroundColor="Transparent"/>
                    </Border>
                </Grid>
            </Border>
            <!-- GridSplitter between Center and Right panels -->
            <controls2:GridSplitter Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    ResizeBehavior="PreviousAndNext">
                <controls2:GridSplitter.RenderTransform>
                    <TranslateTransform X="-0" />
                </controls2:GridSplitter.RenderTransform>
            </controls2:GridSplitter>


            <!-- Left Panel - Cảnh báo & sự cố (Single Panel) -->
            <Border Grid.Column="0"
                    Background="{ThemeResource MonitoringPanelBackgroundBrush}"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Header with hamburger menu-->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Cảnh báo &amp; sự cố"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                        </StackPanel>

                        <Button x:Name="AlertDistributionMenuButton"
                                Click="AlertPanelMenuButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Mở cửa sổ cảnh báo"
                                ToolTipService.ToolTip="Mở cửa sổ cảnh báo">
                            <FontIcon Glyph="&#xE8A7;"
                                      FontSize="16"
                                      Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!--Content: Chart + Alert List in one ScrollViewer-->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!--Chart Section-->
                            <Border Background="{ThemeResource MonitoringBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!--Time Filter Buttons-->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Button Content="Ngày"
                                                x:Name="AlertDayButton"
                                                Click="AlertTimeFilter_Click"
                                                Tag="Day"
                                                Background="{ThemeResource MonitoringAccentButtonBrush}"
                                                Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                                FontSize="11"
                                                Padding="12,4"
                                                CornerRadius="4"
                                                BorderThickness="0"/>
                                        <Button Content="Tuần"
                                                x:Name="AlertWeekButton"
                                                Click="AlertTimeFilter_Click"
                                                Tag="Week"
                                                Background="Transparent"
                                                Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                                FontSize="11"
                                                Padding="12,4"
                                                CornerRadius="4"
                                                BorderBrush="{ThemeResource MonitoringBorderBrush}"
                                                BorderThickness="1"/>
                                        <Button Content="Tháng"
                                                x:Name="AlertMonthButton"
                                                Click="AlertTimeFilter_Click"
                                                Tag="Month"
                                                Background="Transparent"
                                                Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                                FontSize="11"
                                                Padding="12,4"
                                                CornerRadius="4"
                                                BorderBrush="{ThemeResource MonitoringBorderBrush}"
                                                BorderThickness="1"/>
                                    </StackPanel>

                                    <!--LiveCharts Pie Chart (Donut)-->
                                    <lvc:PieChart Grid.Row="1"
                                                  Height="140"
                                                  Series="{x:Bind ViewModel.AlertDistributionSeries, Mode=OneWay}"
                                                  LegendPosition="Hidden"
                                                  InitialRotation="-90"
                                                  Background="Transparent"
                                                  AnimationsSpeed="00:00:00.4"
                                                  TooltipPosition="Top"/>

                                    <!--Custom Legend-->
                                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityLowBrush}"/>
                                                <TextBlock Text="Thấp" FontSize="12" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.IntruAlerts, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityMediumBrush}"/>
                                                <TextBlock Text="Trung bình" FontSize="12" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.MotionAlerts, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityHighBrush}"/>
                                                <TextBlock Text="Cao" FontSize="12" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.FireAlerts, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityCriticalBrush}"/>
                                                <TextBlock Text="Nghiêm trọng" FontSize="12" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.SmokeAlerts, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Empty state: shown instead of a blank panel when no alert is open -->
                            <Border Background="{ThemeResource MonitoringBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="12,14"
                                    Visibility="{x:Bind views:MonitoringDashboardPage.VisibleWhenZero(ViewModel.RealtimeAlerts.Count), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{ThemeResource SeverityLowBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Không có cảnh báo đang mở"
                                               FontSize="12"
                                               Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!--Alert List Section - live from MockDataService-->
                            <Border Background="{ThemeResource MonitoringBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Visibility="{x:Bind views:MonitoringDashboardPage.VisibleWhenPositive(ViewModel.RealtimeAlerts.Count), Mode=OneWay}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.RealtimeAlerts, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:RealtimeAlert">
                                            <Border Background="{ThemeResource MonitoringBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    BorderBrush="{ThemeResource MonitoringBorderBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0"
                                                             Width="8"
                                                             Height="8"
                                                             Fill="{Binding SeverityBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding SeverityLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   CharacterSpacing="60"
                                                                   Foreground="{Binding SeverityBrush}"
                                                                   Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Message}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Source}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TimeText}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource MonitoringTextSecondaryBrush}"
                                                               VerticalAlignment="Top"
                                                               Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Horizontal GridSplitter between Main Content and Bottom Section -->
        <controls2:GridSplitter Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                ResizeBehavior="PreviousAndNext"
                                Background="Transparent">
        </controls2:GridSplitter>

        <!-- Bottom Section - System Status, Data Monitoring, Camera -->
        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- System Status Panel -->
            <Border Grid.Column="0" Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="8" Padding="20" Margin="0,0,8,0" MinHeight="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Trạng thái hệ thống" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="DevicePanelMenuButton"
                                Click="DevicePanelMenuButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Mở cửa sổ thiết bị"
                                ToolTipService.ToolTip="Mở cửa sổ thiết bị">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!-- Device health: one number plus a bar -->
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Thiết bị trực tuyến" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.SystemHealthText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Height="6" CornerRadius="3"
                                             Value="{x:Bind ViewModel.SystemHealth, Mode=OneWay}"
                                             Foreground="{ThemeResource SeverityLowBrush}"
                                             Background="{ThemeResource MonitoringBackgroundBrush}"
                                             AutomationProperties.Name="Tỷ lệ thiết bị trực tuyến"/>
                            </StackPanel>

                            <!-- Counters: 2x2 cells split by hairlines -->
                            <Border Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Grid.Row="0" Padding="14,10" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nút" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.TotalNodes, Mode=OneWay}" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="{ThemeResource MonitoringBorderBrush}"/>
                                <StackPanel Grid.Column="2" Grid.Row="0" Padding="14,10" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="9" Height="9" Fill="{ThemeResource SeverityLowBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tốt" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.OnlineSensors, Mode=OneWay}" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </StackPanel>
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{ThemeResource MonitoringBorderBrush}"/>
                                <StackPanel Grid.Column="0" Grid.Row="2" Padding="14,10" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource SeverityCriticalBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bất thường" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.AnomalyCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="2" Padding="14,10" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource SeverityHighBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cảnh báo" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ActiveAlertCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Online ratios -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Camera" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CameraCountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="Cảm biến" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SensorCountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- Data Monitoring Panel - Combined -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{ThemeResource MonitoringPanelBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0" MinHeight="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Giám sát dữ liệu" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                            <TextBlock Text="Cảm biến xấu nhất của mỗi loại" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="DataPanelMenuButton"
                                Click="DataPanelMenuButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Mở cửa sổ dữ liệu"
                                ToolTipService.ToolTip="Mở cửa sổ dữ liệu">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Worst sensor per category (a station has ~40 sensors of each type, so an average hides the one that matters).
                         Each column: tag + status shape, worst value, where it is, its own sparkline vs. warning threshold (dashed), how many are over. -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="520" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TEMP -->
                            <Border Grid.Column="0" Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="24"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="TEMP" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource MonitoringSensorTempBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Nhiệt độ cao nhất" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                   Text="{x:Bind ViewModel.TempMonitor.LevelGlyph, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.TempMonitor.LevelBrush, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.TempMonitor.LevelText, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind ViewModel.TempMonitor.LevelText, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind ViewModel.TempMonitor.ValueText, Mode=OneWay}"/><Run Text="{x:Bind ViewModel.TempMonitor.UnitText, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/></TextBlock>
                                    <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.TempMonitor.SourceText, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.TempMonitor.SourceTooltip, Mode=OneWay}"/>
                                    <lvc:CartesianChart Grid.Row="3"
                                                        Series="{x:Bind ViewModel.TempMonitor.Series, Mode=OneTime}"
                                                        XAxes="{x:Bind ViewModel.CreateHiddenXAxes(), Mode=OneTime}"
                                                        YAxes="{x:Bind ViewModel.CreateHiddenYAxes(), Mode=OneTime}"
                                                        TooltipPosition="Hidden"
                                                        Background="Transparent"
                                                        AutomationProperties.Name="Xu hướng nhiệt độ của cảm biến cao nhất"/>
                                    <TextBlock Grid.Row="4" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.TempMonitor.CountText, Mode=OneWay}"
                                               Foreground="{x:Bind ViewModel.TempMonitor.CountBrush, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <!-- HUM -->
                            <Border Grid.Column="1" Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="24"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="HUM" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource MonitoringSensorHumidityBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Độ ẩm cao nhất" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                   Text="{x:Bind ViewModel.HumMonitor.LevelGlyph, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.HumMonitor.LevelBrush, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.HumMonitor.LevelText, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind ViewModel.HumMonitor.LevelText, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind ViewModel.HumMonitor.ValueText, Mode=OneWay}"/><Run Text="{x:Bind ViewModel.HumMonitor.UnitText, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/></TextBlock>
                                    <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.HumMonitor.SourceText, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.HumMonitor.SourceTooltip, Mode=OneWay}"/>
                                    <lvc:CartesianChart Grid.Row="3"
                                                        Series="{x:Bind ViewModel.HumMonitor.Series, Mode=OneTime}"
                                                        XAxes="{x:Bind ViewModel.CreateHiddenXAxes(), Mode=OneTime}"
                                                        YAxes="{x:Bind ViewModel.CreateHiddenYAxes(), Mode=OneTime}"
                                                        TooltipPosition="Hidden"
                                                        Background="Transparent"
                                                        AutomationProperties.Name="Xu hướng độ ẩm của cảm biến cao nhất"/>
                                    <TextBlock Grid.Row="4" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.HumMonitor.CountText, Mode=OneWay}"
                                               Foreground="{x:Bind ViewModel.HumMonitor.CountBrush, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <!-- RAD -->
                            <Border Grid.Column="2" Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="24"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="RAD" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource MonitoringSensorRadarBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Radar hiện diện cao nhất" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                   Text="{x:Bind ViewModel.RadarMonitor.LevelGlyph, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.RadarMonitor.LevelBrush, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.RadarMonitor.LevelText, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind ViewModel.RadarMonitor.LevelText, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind ViewModel.RadarMonitor.ValueText, Mode=OneWay}"/><Run Text="{x:Bind ViewModel.RadarMonitor.UnitText, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/></TextBlock>
                                    <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.RadarMonitor.SourceText, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.RadarMonitor.SourceTooltip, Mode=OneWay}"/>
                                    <lvc:CartesianChart Grid.Row="3"
                                                        Series="{x:Bind ViewModel.RadarMonitor.Series, Mode=OneTime}"
                                                        XAxes="{x:Bind ViewModel.CreateHiddenXAxes(), Mode=OneTime}"
                                                        YAxes="{x:Bind ViewModel.CreateHiddenYAxes(), Mode=OneTime}"
                                                        TooltipPosition="Hidden"
                                                        Background="Transparent"
                                                        AutomationProperties.Name="Xu hướng radar của cảm biến cao nhất"/>
                                    <TextBlock Grid.Row="4" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.RadarMonitor.CountText, Mode=OneWay}"
                                               Foreground="{x:Bind ViewModel.RadarMonitor.CountBrush, Mode=OneWay}"/>
                                </Grid>
                            </Border>

                            <!-- PIR -->
                            <Border Grid.Column="3" Background="{ThemeResource MonitoringBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <Grid RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="24"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource MonitoringPanelBackgroundBrush}" BorderBrush="{ThemeResource MonitoringBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="PIR" FontSize="10" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource MonitoringSensorInfraredBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Hồng ngoại cao nhất" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                   Text="{x:Bind ViewModel.PirMonitor.LevelGlyph, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.PirMonitor.LevelBrush, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.PirMonitor.LevelText, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind ViewModel.PirMonitor.LevelText, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource MonitoringTextPrimaryBrush}" TextTrimming="CharacterEllipsis"><Run Text="{x:Bind ViewModel.PirMonitor.ValueText, Mode=OneWay}"/><Run Text="{x:Bind ViewModel.PirMonitor.UnitText, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/></TextBlock>
                                    <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource MonitoringTextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.PirMonitor.SourceText, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.PirMonitor.SourceTooltip, Mode=OneWay}"/>
                                    <lvc:CartesianChart Grid.Row="3"
                                                        Series="{x:Bind ViewModel.PirMonitor.Series, Mode=OneTime}"
                                                        XAxes="{x:Bind ViewModel.CreateHiddenXAxes(), Mode=OneTime}"
                                                        YAxes="{x:Bind ViewModel.CreateHiddenYAxes(), Mode=OneTime}"
                                                        TooltipPosition="Hidden"
                                                        Background="Transparent"
                                                        AutomationProperties.Name="Xu hướng hồng ngoại của cảm biến cao nhất"/>
                                    <TextBlock Grid.Row="4" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.PirMonitor.CountText, Mode=OneWay}"
                                               Foreground="{x:Bind ViewModel.PirMonitor.CountBrush, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- Camera Rotation Panel -->
            <Border Grid.Column="3"
                    Background="{ThemeResource MonitoringPanelBackgroundBrush}"
                    CornerRadius="8"
                    Padding="16"
                    MinHeight="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Camera giám sát"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button x:Name="CameraPauseButton"
                                    Click="CameraPauseButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    AutomationProperties.Name="Tạm dừng xoay camera"
                                    ToolTipService.ToolTip="Tạm dừng">
                                <FontIcon x:Name="CameraPauseIcon"
                                          Glyph="&#xE769;"
                                          FontSize="12"
                                          Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                            </Button>

                            <Button x:Name="CameraPanelMenuButton"
                                    Click="CameraPanelMenuButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    AutomationProperties.Name="Mở cửa sổ camera"
                                    ToolTipService.ToolTip="Mở cửa sổ camera">
                                <FontIcon Glyph="&#xE8A7;"
                                          FontSize="12"
                                          Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Camera Display -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource DkBgBrush}"
                            CornerRadius="6">
                        <Grid>
                            <!-- Camera Feed -->
                            <Image x:Name="CurrentCameraImage"
                                   Stretch="UniformToFill"/>

                            <!-- Alert Overlay -->
                            <Border x:Name="AlertOverlay"
                                    Background="{ThemeResource MonitoringAlertFillBrush}"
                                    Visibility="Collapsed"
                                    BorderBrush="{ThemeResource SeverityCriticalBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6">
                                <Grid VerticalAlignment="Top"
                                      Background="{ThemeResource MonitoringCameraAlertBannerBrush}"
                                      Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7BA;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                        <TextBlock x:Name="AlertMessageText"
                                                   Text="PHÁT HIỆN BẤT THƯỜNG"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Camera Info Overlay -->
                            <Grid VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Background="{ThemeResource MonitoringCameraOverlayBrush}"
                                  Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CurrentCameraName"
                                           Grid.Column="0"
                                           Text="CAM-01"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>

                                <Border Grid.Column="1"
                                        x:Name="CurrentCameraStatusBadge"
                                        Background="{ThemeResource SeverityLowBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock x:Name="CurrentCameraStatus"
                                               Text="Online"
                                               FontSize="11"
                                               Foreground="{ThemeResource DkDeepBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Time & Recording -->
                            <Grid VerticalAlignment="Bottom">
                                <Border HorizontalAlignment="Left"
                                        Background="{ThemeResource MonitoringCameraOverlayBrush}"
                                        Padding="6,3"
                                        Margin="8,8">
                                    <TextBlock x:Name="CurrentCameraTime"
                                               Text="09:20:25"
                                               FontSize="11"
                                               Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                </Border>

                                <Border HorizontalAlignment="Right"
                                        Background="{ThemeResource MonitoringCameraOverlayBrush}"
                                        Padding="6,3"
                                        Margin="8,8"
                                        x:Name="RecordingIndicator">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SeverityCriticalBrush}"/>
                                        <TextBlock Text="REC"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource MonitoringTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- No Signal Overlay -->
                            <Grid x:Name="NoSignalOverlay"
                                  Background="{ThemeResource DkBgBrush}"
                                  Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE711;"
                                              FontSize="24"
                                              Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                                    <TextBlock Text="Không có tín hiệu"
                                               FontSize="11"
                                               Foreground="{ThemeResource MonitoringTextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Camera Info & Controls -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;"
                                      FontSize="11"
                                      Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                            <TextBlock x:Name="CameraRotationInfo"
                                       Text="Tự động: 10s"
                                       FontSize="11"
                                       Foreground="{ThemeResource MonitoringTextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="NextCameraInfo"
                                   Text="Tiếp: CAM 02 (8s)"
                                   FontSize="11"
                                   Foreground="{ThemeResource MonitoringAccentButtonBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    <!-- ─── END MAIN CONTENT ─── -->

    <!-- Red screen flash overlay (full coverage, pointer-transparent) -->
    <Border x:Name="RedFlashOverlay"
            Background="{ThemeResource SeverityCriticalBrush}"
            Opacity="0"
            IsHitTestVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

    <!-- Floating alert notification badge (top-right, appears on alert) -->
    <Button x:Name="AlertNotificationBadge"
            Click="AlertNotificationBadge_Click"
            PointerEntered="AlertBadge_PointerEntered"
            PointerExited="AlertBadge_PointerExited"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,24,0"
            Background="{ThemeResource MonitoringAlertBadgeBgBrush}"
            BorderBrush="{ThemeResource DkRedBrush}"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="14,9"
            ToolTipService.ToolTip="Nhấn để xem chi tiết cảnh báo">
        <Button.Resources>
            <!-- Keep solid background on hover/press, no transparency bleed -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B91C1C"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="#7F1D1D"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#EF4444"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="#FCA5A5"/>
        </Button.Resources>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Pulsing dot -->
            <Ellipse Width="8" Height="8" Fill="#FCA5A5" VerticalAlignment="Center"/>
            <!-- Exclamation icon -->
            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#FECACA"/>
            <!-- Alert count badge -->
            <Border x:Name="AlertBadgeCountBorder"
                    Background="{ThemeResource DkRedBrush}" CornerRadius="4"
                    Padding="7,2" MinWidth="22"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="AlertBadgeCountText"
                           Text="1" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Center"/>
            </Border>
            <!-- Label -->
            <TextBlock Text="CẢNH BÁO" FontSize="12" FontWeight="Bold"
                       Foreground="#FECACA" VerticalAlignment="Center"
                       CharacterSpacing="60"/>
        </StackPanel>
    </Button>

    <!-- Floating join-request notification badge (appears below alert badge) -->
    <Button x:Name="JoinRequestBadge"
            Click="JoinRequestBadge_Click"
            PointerEntered="JoinBadge_PointerEntered"
            PointerExited="JoinBadge_PointerExited"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,72,24,0"
            Background="{ThemeResource MonitoringJoinBadgeBgBrush}"
            BorderBrush="{ThemeResource MonitoringJoinBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="14,9"
            ToolTipService.ToolTip="Thiết bị mới yêu cầu kết nối — nhấn để phê duyệt hoặc từ chối">
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#92400E"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="#451A03"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F59E0B"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="#FDE68A"/>
        </Button.Resources>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Pulsing dot -->
            <Ellipse Width="8" Height="8" Fill="#FDE68A" VerticalAlignment="Center"/>
            <!-- Count badge -->
            <Border x:Name="JoinBadgeCountBorder"
                    Background="#F59E0B" CornerRadius="4"
                    Padding="7,2" MinWidth="22"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="JoinBadgeCountText"
                           Text="1" FontSize="11" FontWeight="Bold"
                           Foreground="{ThemeResource MonitoringTextPrimaryBrush}" HorizontalAlignment="Center"/>
            </Border>
            <!-- Label -->
            <TextBlock Text="THIẾT BỊ MỚI" FontSize="12" FontWeight="Bold"
                       Foreground="#FEF3C7" VerticalAlignment="Center"
                       CharacterSpacing="60"/>
        </StackPanel>
    </Button>

    </Grid><!-- outer container -->
</Page>
