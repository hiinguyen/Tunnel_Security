<Page
    x:Class="Station.Views.AnalyticsReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:views="using:Station.Views"
    mc:Ignorable="d"
    Background="{ThemeResource DkBgBrush}">

    <!-- =================== RESOURCES =================== -->
    <Page.Resources>
        <!-- Filter combo: Dk combo, left aligned so the filter row does not stretch -->
        <Style x:Key="AnalyticsFilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DkComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <!-- Section card: surface, 1px border, radius 12 -->
        <Style x:Key="AnalyticsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DkSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="AnalyticsCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="AnalyticsCardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="AnalyticsLegendTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AnalyticsKpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextSecondaryBrush}"/>
        </Style>

        <Style x:Key="AnalyticsKpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXXLarge}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextPrimaryBrush}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="AnalyticsKpiNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
            <Setter Property="Foreground" Value="{ThemeResource DkTextMutedBrush}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </Page.Resources>

    <!-- =================== PAGE LAYOUT =================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========= HEADER: back, title, theme, export ========= -->
        <Border Grid.Row="0"
                Background="{ThemeResource DkSurfaceBrush}"
                BorderBrush="{ThemeResource DkBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Style="{StaticResource DkIconButtonStyle}"
                            Click="BackButton_Click"
                            ToolTipService.ToolTip="Quay lại"
                            AutomationProperties.Name="Quay lại">
                        <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource FontSizeSmall}"/>
                    </Button>
                    <TextBlock Text="Phân tích và báo cáo"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{ThemeResource DkBorderBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Trạm Nghĩa Đô · TRM-HN-001"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{ThemeResource DkTextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource DkIconButtonStyle}"
                            Click="ThemeToggleButton_Click"
                            ToolTipService.ToolTip="Chuyển đổi chế độ sáng/tối"
                            AutomationProperties.Name="Chuyển đổi chế độ sáng/tối">
                        <Grid>
                            <FontIcon x:Name="MoonIcon" Glyph="&#xE708;" FontSize="{StaticResource FontSizeBody}"/>
                            <FontIcon x:Name="SunIcon" Glyph="&#xE706;" FontSize="{StaticResource FontSizeBody}"
                                      Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource DkSecondaryButtonStyle}" Content="Xuất PDF" Click="ExportPdf_Click"/>
                    <Button Style="{StaticResource DkPrimaryButtonStyle}" Content="Xuất Excel" Click="ExportExcel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================== MAIN CONTENT =================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16,24,24">
            <!-- R0: KPI strip; R1: filters; R2: overview charts; R3: realtime + mix; R4: heatmap; R5: history -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="330"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="360"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== KPI STRIP: one continuous surface, geometric marker per cell ===== -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Style="{StaticResource AnalyticsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tổng số cảnh báo -->
                    <StackPanel Grid.Column="0" Padding="24,16" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                       Fill="{ThemeResource DkTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Tổng số cảnh báo" Style="{StaticResource AnalyticsKpiLabelStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalAlertsValue" Text="0" Style="{StaticResource AnalyticsKpiValueStyle}"/>
                        <TextBlock x:Name="TotalAlertsChange" Text="+0% so với kỳ trước"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"/>
                        <TextBlock x:Name="ProcessedSummaryText" Text="Đã xử lý: 0 (0%)"
                                   Style="{StaticResource AnalyticsKpiNoteStyle}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="OpenSummaryText" Text="Đang mở: 0 (0%)"
                                   Style="{StaticResource AnalyticsKpiNoteStyle}"/>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Fill="{ThemeResource DkBorderBrush}"/>

                    <!-- Cảnh báo nghiêm trọng -->
                    <StackPanel Grid.Column="2" Padding="24,16" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkRedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Cảnh báo nghiêm trọng" Style="{StaticResource AnalyticsKpiLabelStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="SevereAlertsValue" Text="0" Style="{StaticResource AnalyticsKpiValueStyle}"/>
                        <TextBlock x:Name="SevereAlertsChange" Text="0 so với kỳ trước"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{ThemeResource DkTextMutedBrush}"/>
                        <TextBlock x:Name="LineCountText" Text="Số tuyến có cảnh báo: 0"
                                   Style="{StaticResource AnalyticsKpiNoteStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Fill="{ThemeResource DkBorderBrush}"/>

                    <!-- Điểm nóng hiện tại -->
                    <StackPanel Grid.Column="4" Padding="24,16" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkYellowBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Điểm nóng hiện tại" Style="{StaticResource AnalyticsKpiLabelStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="HotspotNodeText" Text="-" Style="{StaticResource AnalyticsKpiValueStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HotspotNodeDetailText" Text="Chưa có dữ liệu"
                                   Style="{StaticResource AnalyticsKpiNoteStyle}"/>
                    </StackPanel>

                    <Rectangle Grid.Column="5" Fill="{ThemeResource DkBorderBrush}"/>

                    <!-- Thiết bị đang online -->
                    <StackPanel Grid.Column="6" Padding="24,16" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource DkGreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Thiết bị đang online" Style="{StaticResource AnalyticsKpiLabelStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="OnlineDeviceText" Text="-" Style="{StaticResource AnalyticsKpiValueStyle}"/>
                        <TextBlock x:Name="AvgHandleTimeText" Text="Thời gian xử lý TB: -"
                                   Style="{StaticResource AnalyticsKpiNoteStyle}"/>
                        <TextBlock x:Name="RealtimeSampleText" Text="Snapshot: chờ dữ liệu"
                                   Style="{StaticResource AnalyticsKpiNoteStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== FILTER BAR ===== -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="8"
                        Margin="0,16,0,16">
                <ComboBox x:Name="PeriodFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          AutomationProperties.Name="Mốc thời gian"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="LineFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          AutomationProperties.Name="Tuyến"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="NodeFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          MinWidth="135"
                          AutomationProperties.Name="Nút"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="CameraFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          MinWidth="145"
                          AutomationProperties.Name="Camera"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="SeverityFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          AutomationProperties.Name="Mức cảnh báo"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="StatusFilterComboBox"
                          Style="{StaticResource AnalyticsFilterComboBoxStyle}"
                          AutomationProperties.Name="Trạng thái xử lý"
                          SelectionChanged="Filter_SelectionChanged"/>
            </StackPanel>

            <!-- ===== ROW 2: TREND + TOP SOURCES ===== -->
            <Border Grid.Row="2" Grid.Column="0"
                    Margin="0,0,8,16"
                    Style="{StaticResource AnalyticsCardStyle}">
                <StackPanel Margin="20">
                    <TextBlock Text="Xu hướng cảnh báo" Style="{StaticResource AnalyticsCardTitleStyle}"/>
                    <TextBlock Text="Tổng số, nghiêm trọng, cảnh báo và các ngưỡng vận hành"
                               Style="{StaticResource AnalyticsCardSubtitleStyle}" Margin="0,3,0,0"/>

                    <lvc:CartesianChart Margin="0,12,0,0"
                                        Height="185"
                                        Series="{x:Bind OverviewTrendSeries}"
                                        XAxes="{x:Bind OverviewTrendAxes}"
                                        YAxes="{x:Bind OverviewTrendYAxes}"
                                        LegendPosition="Hidden"
                                        TooltipPosition="Top"
                                        Background="Transparent"/>

                    <StackPanel Margin="0,10,0,0" Spacing="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="14" Height="3" Fill="{ThemeResource DkRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngưỡng nghiêm trọng" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="14" Height="3" Fill="{ThemeResource DkYellowBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngưỡng cảnh báo" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="14" Height="3" Fill="{ThemeResource DkGreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Giá trị kỳ vọng" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource DkBlueBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng số" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource DkRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Nghiêm trọng" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource DkOrangeBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Cảnh báo" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1"
                    Margin="8,0,0,16"
                    Style="{StaticResource AnalyticsCardStyle}">
                <StackPanel Margin="20">
                    <TextBlock Text="Top nguồn phát sinh cảnh báo" Style="{StaticResource AnalyticsCardTitleStyle}"/>
                    <TextBlock Text="Các sensor, camera, radar có số cảnh báo cao nhất trong bộ lọc hiện tại"
                               Style="{StaticResource AnalyticsCardSubtitleStyle}" Margin="0,3,0,0"/>

                    <ItemsRepeater x:Name="TopSourceRepeater" Margin="0,16,0,0">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="views:TopSourceStat">
                                <Grid Height="26" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding SourceCode}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource DkTextSecondaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Grid.Column="1" Height="16" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <Border Background="{ThemeResource DkInputBgBrush}" CornerRadius="4"/>
                                        <Border Width="{Binding BarWidth}"
                                                Background="{Binding BarBrush}"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"/>
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AlertCount}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource DkTextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="Bold"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ===== ROW 3: REALTIME RHYTHM + SEVERITY MIX ===== -->
            <Border Grid.Row="3" Grid.Column="0"
                    Margin="0,0,8,16"
                    Style="{StaticResource AnalyticsCardStyle}">
                <StackPanel Margin="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nhịp cảnh báo 12 phút gần nhất" Style="{StaticResource AnalyticsCardTitleStyle}"/>
                            <TextBlock x:Name="RealtimeWindowText"
                                       Text="Số cảnh báo mới/phút, tách rõ rủi ro cao và cảnh báo chưa đóng"
                                       Style="{StaticResource AnalyticsCardSubtitleStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="8,3"
                                CornerRadius="4"
                                Margin="12,0,0,0"
                                Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="RealtimeStatusText"
                                       Text="SNAPSHOT"
                                       Style="{StaticResource DkTagTextStyle}"/>
                        </Border>
                    </Grid>

                    <lvc:CartesianChart Margin="0,14,0,0"
                                        Height="190"
                                        Series="{x:Bind RealtimeTrendSeries}"
                                        XAxes="{x:Bind RealtimeAxes}"
                                        YAxes="{x:Bind RealtimeYAxes}"
                                        Background="Transparent"
                                        TooltipPosition="Top"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="1"
                    Margin="8,0,0,16"
                    Style="{StaticResource AnalyticsCardStyle}">
                <StackPanel Margin="20">
                    <TextBlock Text="Cơ cấu mức độ cảnh báo" Style="{StaticResource AnalyticsCardTitleStyle}"/>
                    <TextBlock x:Name="SeverityMixText"
                               Text="Tỷ trọng nghiêm trọng, cao, trung bình, thấp"
                               Style="{StaticResource AnalyticsCardSubtitleStyle}" Margin="0,3,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <lvc:PieChart Grid.Column="0"
                                      Height="190"
                                      Series="{x:Bind SeverityDonutSeries}"
                                      InitialRotation="-90"
                                      LegendPosition="Hidden"
                                      TooltipPosition="Top"
                                      Background="Transparent"/>

                        <!-- Legend: marker shape + label, so level never relies on color alone -->
                        <StackPanel Grid.Column="1" MinWidth="160" Margin="18,18,0,0" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SeverityCriticalLegendText" Text="Nghiêm trọng"
                                           Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Polygon Points="4.5,0 9,8 0,8" Fill="{ThemeResource DkOrangeBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SeverityHighLegendText" Text="Cao"
                                           Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                           Fill="{ThemeResource DkYellowBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SeverityMediumLegendText" Text="Trung bình"
                                           Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource DkGreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SeverityLowLegendText" Text="Thấp"
                                           Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== ROW 4: HEATMAP DAY / HOUR ===== -->
            <Border Grid.Row="4" Grid.ColumnSpan="2"
                    Margin="0,0,0,16"
                    Style="{StaticResource AnalyticsCardStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bản đồ nhịp cảnh báo theo ngày / giờ" Style="{StaticResource AnalyticsCardTitleStyle}"/>
                            <TextBlock Text="Mỗi ô là số cảnh báo tại giao điểm ngày-giờ; màu chuyển từ xanh sang hồng khi mật độ tăng"
                                       Style="{StaticResource AnalyticsCardSubtitleStyle}" Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <TextBlock Text="Ít" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                                <Border Width="160" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#60A5FA" Offset="0"/>
                                            <GradientStop Color="#818CF8" Offset="0.34"/>
                                            <GradientStop Color="#C084FC" Offset="0.66"/>
                                            <GradientStop Color="#FB7185" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Nhiều" Style="{StaticResource AnalyticsLegendTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="8,3"
                                CornerRadius="4"
                                Background="{ThemeResource DkInputBgBrush}"
                                BorderBrush="{ThemeResource DkBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="PeakHourText" Text="-" Style="{StaticResource DkTagTextStyle}"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,12,8">
                            <TextBlock Text="TỔNG THEO GIỜ" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock x:Name="HeatmapTotalText"
                                       Text="0 cảnh báo"
                                       FontSize="{StaticResource FontSizeMedium}"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource DkTextPrimaryBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None"
                                       Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>

                        <ItemsRepeater x:Name="HeatmapHourBarsRepeater" Grid.Row="0" Grid.Column="1">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="24" MinColumnSpacing="3" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:HourBucketStat">
                                    <Grid Height="76" ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border Width="12"
                                                Height="{Binding BarHeight}"
                                                Background="{Binding Brush}"
                                                CornerRadius="3,3,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Opacity="{Binding Opacity}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="NGÀY | GIỜ"
                                   Style="{StaticResource DkLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <ItemsRepeater x:Name="HeatmapHourLabelsRepeater" Grid.Row="1" Grid.Column="1">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="24" MinColumnSpacing="3" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource DkTextMutedBrush}"
                                               FontSize="{StaticResource FontSizeXSmall}"
                                               Typography.NumeralAlignment="Tabular"/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ItemsRepeater x:Name="HeatmapDayBarsRepeater" Grid.Row="2" Grid.Column="0" Margin="0,8,12,0">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:DayBucketStat">
                                    <Grid Height="25" ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border Width="{Binding BarWidth}"
                                                Background="{Binding Brush}"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Height="18"
                                                Opacity="{Binding Opacity}"/>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeXSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ItemsRepeater x:Name="HeatmapRepeater" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="24" MinColumnSpacing="0" MinRowSpacing="0" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="views:HeatmapCell">
                                    <Grid Height="25" ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border BorderBrush="{Binding GridLineBrush}"
                                                BorderThickness="0.5"
                                                Background="{Binding CellOverlayBrush}"
                                                Opacity="{Binding CellOpacity}"/>
                                        <Border BorderBrush="{Binding HighlightBrush}"
                                                BorderThickness="{Binding HighlightThickness}"
                                                Opacity="0.45"/>
                                        <TextBlock Text="{Binding CountText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding CountForeground}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== ROW 5: ALERT HISTORY ===== -->
            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource AnalyticsCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dữ liệu lịch sử cảnh báo"
                                       Style="{StaticResource AnalyticsCardTitleStyle}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource DkSecondaryButtonStyle}"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71C;" FontSize="{StaticResource FontSizeSmall}"/>
                                    <TextBlock Text="Lọc nâng cao"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Column headers -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource DkInputBgBrush}"
                            BorderBrush="{ThemeResource DkBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="THỜI GIAN" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="TUYẾN" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock Grid.Column="2" Text="NÚT" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock Grid.Column="3" Text="LOẠI CẢNH BÁO" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock Grid.Column="4" Text="MỨC ĐỘ" Style="{StaticResource DkLabelStyle}"/>
                            <TextBlock Grid.Column="5" Text="TRẠNG THÁI XỬ LÝ" Style="{StaticResource DkLabelStyle}"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="HistoryGrid"
                              Grid.Row="2"
                              Height="360"
                              MaxHeight="360"
                              IsItemClickEnabled="False"
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource DkBorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        MinHeight="44"
                                        Padding="20,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Line}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Node}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AlertType}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DkTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="4"
                                                Background="{ThemeResource DkInputBgBrush}"
                                                BorderBrush="{ThemeResource DkBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource DkTextPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding Status}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource DkTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
