{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "ClientId": "backendv2",
    "Username": "admin",
    "DynamicSecurity": {
      "Enabled": true,
      "ProvisioningUsername": "provision"
    }
  },
  "Gateway": {
    "NodeTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 3,
    "CommandMaxAttempts": 3,
    "AutoApproveGateways": false,
    "LevelRecoverySamples": 3
  },
  "Station": {
    "Id": "ST-01",
    "SafetyIntervalSeconds": 30
  },
  "ReadingWriter": {
    "Capacity": 50000,
    "BatchSize": 1000,
    "FlushIntervalMs": 500
  }
}
