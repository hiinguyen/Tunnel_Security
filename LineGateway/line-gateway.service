[Unit]
Description=Tunnel Security line gateway (NM)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/line-gateway
ExecStart=/opt/line-gateway/LineGateway
EnvironmentFile=/etc/line-gateway.env
StateDirectory=line-gateway
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
